<mxfile host="app.diagrams.net"><diagram id="homepi-target" name="Target architecture v1"><mxGraphModel dx="1900" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="1140" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="HomePi: target architecture v1 (edge platform + AWS landing zone), status 2026-11-07" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="36" as="geometry"/></mxCell><mxCell id="v2" value="&lt;b&gt;SCP guardrails&lt;/b&gt; on both OUs &lt;font color=&quot;#D45B07&quot;&gt;&lt;b&gt;&amp;#9675; D4&lt;/b&gt;&lt;/font&gt;: Tokyo region only (global services exempt), deny leaving the organization, deny stopping or deleting CloudTrail, deny root user in member accounts, deny s3:BypassGovernanceRetention. No workload runs in the management account." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="1000" height="50" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt; exists and is verified&lt;br&gt;&lt;font color=&quot;#D45B07&quot;&gt;&lt;b&gt;&amp;#9675; A1&lt;/b&gt;&lt;/font&gt; planned, roadmap step (docs/roadmap.md)&lt;br&gt;Solid arrow: data or control flow&lt;br&gt;Dashed arrow: restore or break-glass path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#7D8998;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1450" y="8" width="400" height="92" as="geometry"/></mxCell><mxCell id="v4" value="Home (on-premises, Japan)" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_corporate_data_center;strokeColor=#7D8998;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#5A6C86;dashed=0;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="340" height="1010" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;ESP32 sensors&lt;/b&gt;&lt;br&gt;isolated IoT Wi-Fi 192.168.200.0/24&lt;br&gt;MQTT over mTLS, per-device X.509 &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#7D8998;fontColor=#232F3E;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="290" height="70" as="geometry"/></mxCell><mxCell id="v6" value="&lt;b&gt;Raspberry Pi 5 &amp;mdash; HomePi&lt;/b&gt; (LUKS2 NVMe, LVM)&lt;br&gt;&lt;b&gt;Data&lt;/b&gt;: Mosquitto mTLS, Telegraf, InfluxDB &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Observability&lt;/b&gt;: Prometheus, Alertmanager, Loki, Alloy, Grafana &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Access&lt;/b&gt;: Nginx, Authelia 2FA, CrowdSec, NetBird &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;PKI&lt;/b&gt;: step-ca &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt; &amp;nbsp;&lt;b&gt;Edge AI&lt;/b&gt;: Hailo-8L &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;DNS&lt;/b&gt;: Unbound as system resolver &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Operations&lt;/b&gt;&lt;br&gt;GitOps pull from GitHub, signed tags &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Encrypted backups, nightly + weekly &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Off-site upload hourly, 36 h alert &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Heartbeat relay (Watchdog, 1/min) &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Every config managed by Ansible &lt;font color=&quot;#D45B07&quot;&gt;&lt;b&gt;&amp;#9675; B&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Loki on its own XFS volume &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F5E1;strokeColor=#7AA116;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="290" height="330" as="geometry"/></mxCell><mxCell id="v7" value="&lt;b&gt;Laptop&lt;/b&gt;&lt;br&gt;release signing key, SOPS age key&lt;br&gt;break-glass Terraform (SSO) &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#7D8998;fontColor=#232F3E;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="290" height="80" as="geometry"/></mxCell><mxCell id="v8" value="&lt;b&gt;Louis: e-mail on phone&lt;/b&gt;&lt;br&gt;independent of the Pi, its DNS and Slack &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#7D8998;fontColor=#232F3E;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="290" height="64" as="geometry"/></mxCell><mxCell id="v9" value="&lt;b&gt;USB recovery key&lt;/b&gt;&lt;br&gt;age recovery key, runbooks &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#7D8998;fontColor=#232F3E;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="140" height="80" as="geometry"/></mxCell><mxCell id="v10" value="&lt;b&gt;Spare SSD&lt;/b&gt;&lt;br&gt;game day: full rebuild timed vs RTO 4 h &lt;font color=&quot;#D45B07&quot;&gt;&lt;b&gt;&amp;#9675; C&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#7D8998;fontColor=#232F3E;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="190" y="930" width="140" height="80" as="geometry"/></mxCell><mxCell id="e11" value="MQTT mTLS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v5" target="v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v12" value="GitHub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#24292F;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#24292F;" vertex="1" parent="1"><mxGeometry x="400" y="110" width="290" height="1010" as="geometry"/></mxCell><mxCell id="v13" value="&lt;b&gt;Repository homepi-infra&lt;/b&gt;&lt;br&gt;Ansible, Terraform, docs, incidents&lt;br&gt;secrets SOPS-encrypted, gitleaks&lt;br&gt;signed tags, read-only deploy key &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#7D8998;fontColor=#232F3E;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="415" y="150" width="260" height="100" as="geometry"/></mxCell><mxCell id="v14" value="&lt;b&gt;CI checks on pull request&lt;/b&gt;&lt;br&gt;ansible-lint, yamllint, terraform validate,&lt;br&gt;tflint, trivy, gitleaks, promtool,&lt;br&gt;alloy validate &lt;font color=&quot;#D45B07&quot;&gt;&lt;b&gt;&amp;#9675; D1&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#7D8998;fontColor=#232F3E;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="415" y="300" width="260" height="100" as="geometry"/></mxCell><mxCell id="v15" value="&lt;b&gt;terraform plan&lt;/b&gt;&lt;br&gt;on every pull request &lt;font color=&quot;#D45B07&quot;&gt;&lt;b&gt;&amp;#9675; D1&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#7D8998;fontColor=#232F3E;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="415" y="450" width="260" height="64" as="geometry"/></mxCell><mxCell id="v16" value="&lt;b&gt;terraform apply&lt;/b&gt;&lt;br&gt;main only, protected environment,&lt;br&gt;manual approval &lt;font color=&quot;#D45B07&quot;&gt;&lt;b&gt;&amp;#9675; D1&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#7D8998;fontColor=#232F3E;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="415" y="560" width="260" height="80" as="geometry"/></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v13" target="v14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v14" target="v15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="approval" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v15" target="v16"><mxGeometry relative="1" as="geometry