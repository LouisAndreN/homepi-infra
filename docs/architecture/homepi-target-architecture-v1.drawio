<mxfile host="app.diagrams.net"><diagram id="homepi-architecture" name="Architecture"><mxGraphModel dx="2190" dy="1140" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2190" pageHeight="1140" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="HomePi: architecture (edge platform + AWS organization), status 2026-11-28, v1.5.0" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="36" as="geometry"/></mxCell><mxCell id="v2" value="&lt;b&gt;SCP guardrails&lt;/b&gt; on both OUs &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;: Tokyo region only (global services exempt), deny leaving the organization, deny stopping or deleting CloudTrail, deny root user in member accounts, deny s3:BypassGovernanceRetention. No workload runs in the management account." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#545B64;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="1100" height="50" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt; exists and is verified&lt;br&gt;&lt;font color=&quot;#D45B07&quot;&gt;&lt;b&gt;&amp;#9675; D1&lt;/b&gt;&lt;/font&gt; planned, roadmap step (docs/roadmap.md)&lt;br&gt;Arrow label: how the flow happens (program, command, file)&lt;br&gt;Dashed arrow: planned flow or restore path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#7D8998;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1770" y="8" width="420" height="92" as="geometry"/></mxCell><mxCell id="v4" value="Home (on-premises, Japan)" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_corporate_data_center;strokeColor=#7D8998;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#5A6C86;dashed=0;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="370" height="1010" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;7 x ESP32&lt;/b&gt; (sensors, LED, NILM bridge)&lt;br&gt;isolated IoT Wi-Fi 192.168.200.0/24&lt;br&gt;IDevID + LDevID in NVS &quot;certs&quot;, signed OTA &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#7D8998;fontColor=#232F3E;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="320" height="76" as="geometry"/></mxCell><mxCell id="v6" value="&lt;b&gt;Raspberry Pi 5 &amp;mdash; HomePi&lt;/b&gt; (LUKS2 NVMe, LVM, Btrfs)&lt;br&gt;&lt;b&gt;Data&lt;/b&gt;: Mosquitto mTLS + CRL, Telegraf, InfluxDB &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Observability&lt;/b&gt;: Prometheus (127 rules, unit tests),&lt;br&gt;Alertmanager, Loki, Alloy, Grafana &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;SLOs&lt;/b&gt;: ingestion 99.5%, device API 99%, 28 days &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Access&lt;/b&gt;: nginx, Authelia 2FA, CrowdSec, NetBird,&lt;br&gt;nftables default-deny &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;PKI&lt;/b&gt;: step-ca intermediate (root key offline) &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;DNS&lt;/b&gt;: Unbound, DNSSEC &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Operations&lt;/b&gt;&lt;br&gt;Ansible, 33 roles, every config as code &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;&lt;br&gt;GitOps: homepi-gitops-sync applies signed tags only,&lt;br&gt;hourly drift check &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Grafana as code: Terraform run by GitOps,&lt;br&gt;no destroy without [allow-destroy] &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Encrypted backups (age), nightly + off-site upload &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Heartbeat relay (Alertmanager Watchdog, 1/min) &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Loki on its own XFS volume &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F5E1;strokeColor=#7AA116;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="320" height="370" as="geometry"/></mxCell><mxCell id="v7" value="&lt;b&gt;Laptop&lt;/b&gt;&lt;br&gt;~/homepi-infra, scripts/lib.sh (ship, release)&lt;br&gt;tag signing key, SOPS age key,&lt;br&gt;Manufacturer CA (offline), Terraform (SSO) &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#7D8998;fontColor=#232F3E;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="320" height="96" as="geometry"/></mxCell><mxCell id="v8" value="&lt;b&gt;Louis: e-mail on phone&lt;/b&gt;&lt;br&gt;independent of the Pi, its DNS and Slack &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#7D8998;fontColor=#232F3E;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="320" height="64" as="geometry"/></mxCell><mxCell id="v9" value="&lt;b&gt;USB keys&lt;/b&gt;&lt;br&gt;age recovery key, root CA escrow &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#7D8998;fontColor=#232F3E;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="935" width="150" height="80" as="geometry"/></mxCell><mxCell id="v10" value="&lt;b&gt;Spare SSD&lt;/b&gt;&lt;br&gt;game days C3 to C9: full rebuild, best 48 min 08 s &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#7D8998;fontColor=#232F3E;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="210" y="935" width="150" height="80" as="geometry"/></mxCell><mxCell id="e11" value="MQTT mTLS :8883 with the LDevID;&lt;br&gt;at boot: POST /step/sign (X5C, IDevID)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v5" target="v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v12" value="GitHub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#24292F;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#24292F;" vertex="1" parent="1"><mxGeometry x="700" y="110" width="290" height="1010" as="geometry"/></mxCell><mxCell id="v13" value="&lt;b&gt;Repository homepi-infra&lt;/b&gt;&lt;br&gt;Ansible, Terraform, docs, incidents&lt;br&gt;secrets SOPS-encrypted (ansible/secrets)&lt;br&gt;signed tags, read-only deploy key &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#7D8998;fontColor=#232F3E;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="715" y="150" width="260" height="100" as="geometry"/></mxCell><mxCell id="v14" value="&lt;b&gt;CI: .github/workflows/ci.yml&lt;/b&gt;&lt;br&gt;on push and tags: syntax, promtool&lt;br&gt;rules + unit tests, ansible syntax-check,&lt;br&gt;offline and root tests, changelog &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#7D8998;fontColor=#232F3E;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="715" y="300" width="260" height="100" as="geometry"/></mxCell><mxCell id="v15" value="&lt;b&gt;Terraform in CI&lt;/b&gt;&lt;br&gt;plan on pull request, apply on main&lt;br&gt;after approval, OIDC &lt;font color=&quot;#D45B07&quot;&gt;&lt;b&gt;&amp;#9675; D1&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#7D8998;fontColor=#232F3E;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="715" y="450" width="260" height="80" as="geometry"/></mxCell><mxCell id="e16" value="every push and tag" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v13" target="v14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="v14" target="v15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="homepi-gitops-sync, every 10 min:&lt;br&gt;git fetch (deploy key),&lt;br&gt;git tag -v (allowed_signers),&lt;br&gt;ansible-playbook site.yml" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.3;entryX=1;entryY=0.1;" edge="1" parent="1" source="v13" target="v6"><mxGeometry relative="1" x="-0.1" as="geometry"><Array as="points"><mxPoint x="500" y="180"/><mxPoint x="500" y="317"/></Array></mxGeometry></mxCell><mxCell id="e19" value="ship: git merge --ff-only&lt;br&gt;release: git tag -s,&lt;br&gt;git push pi main + tag" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.25;entryX=0;entryY=0.8;" edge="1" parent="1" source="v7" target="v13"><mxGeometry relative="1" x="0.2" as="geometry"><Array as="points"><mxPoint x="620" y="734"/><mxPoint x="620" y="230"/></Array></mxGeometry></mxCell><mxCell id="e20" value="same push:&lt;br&gt;/var/lib/homepi-gitops/origin.git" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="v7" target="v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v21" value="AWS Cloud: organization (all workloads in ap-northeast-1)" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="1060" y="110" width="1110" height="1010" as="geometry"/></mxCell><mxCell id="v22" value="Management account" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="1"><mxGeometry x="1080" y="150" width="1070" height="170" as="geometry"/></mxCell><mxCell id="i23" value="AWS Organizations, 4 accounts &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;&lt;br&gt;SCPs &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.organizations;" vertex="1" parent="1"><mxGeometry x="1140" y="190" width="60" height="60" as="geometry"/></mxCell><mxCell id="i24" value="IAM Identity Center&lt;br&gt;SSO, MFA &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.single_sign_on;" vertex="1" parent="1"><mxGeometry x="1350" y="190" width="60" height="60" as="geometry"/></mxCell><mxCell id="i25" value="AWS Budgets&lt;br&gt;monthly cost alert &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.budgets;" vertex="1" parent="1"><mxGeometry x="1560" y="190" width="60" height="60" as="geometry"/></mxCell><mxCell id="i26" value="CloudTrail&lt;br&gt;organization trail &lt;font color=&quot;#1D8102&quot;&gt;&lt;b&gt;&amp;#9679; built&lt;/b&gt;&lt;/font&gt;" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudtrail;" vertex="1" parent="1"><mxGeometry x="1770" y="190" width="60" height="60" as="geometry"/></mxCell><mxCell id="e27" value="awsenv / awsmgmt (scripts/lib.sh):&lt;br&gt;aws sso login (MFA),&lt;br&gt;terraform apply (terraform/aws/*)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.75;entryX=0.5;entryY=1;" edge="1" parent="1" source="v7" target="i24"><mxGeometry relative="1" x="-0.62" as="geometry"><Array as="points"><mxPoint x="1030" y="782"/><mxPoint x="1030" y="332"/><mxPoint x="1380" y="332"/></Array></mxGeometry></mxCell><mxCell id="v28" value="OU Workloads" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#545B64;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="1080" y="345" width="640" height="765" as="geometry"/></mxCell><mxCell id="v29" value="Account: homepi" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="1"><mxGeometry x="1095" y="375" width="610" height="720" as="geometry"/></mxCell><mxCell id="v30" value="Asia Pacific (Tokyo) ap-northeast-1" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=1;" vertex="1" parent="1"><mxGeome