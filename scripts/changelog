#!/bin/bash
# changelog: CHANGELOG.md from the signed release tags. One section per minor version: a summary
# written by hand in docs/changelog/MAJOR.MINOR.md, then every tag of that minor, newest first, with
# the subject of its signed annotation. The tag messages are never retyped, so the list cannot
# disagree with the tags; a minor without a summary is an error.
#
#   scripts/changelog > CHANGELOG.md     write it
#   scripts/changelog --check            exit 1 if CHANGELOG.md differs from what the tags give
#   scripts/changelog --next vX.Y.Z "subject" > CHANGELOG.md
#                                        also list the tag about to be made, dated today, so the
#                                        release commit carries its own entry; once the tag exists
#                                        with that subject, --check passes on the same file
set -euo pipefail
REPO="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO"

NEXT=""; NEXT_SUBJECT=""
if [ "${1:-}" = --next ]; then
  [[ "${2:-}" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] && [ -n "${3:-}" ] || { echo "usage: changelog --next vX.Y.Z subject" >&2; exit 2; }
  git rev-parse -q --verify "refs/tags/$2" > /dev/null && { echo "changelog: $2 already exists" >&2; exit 1; }
  NEXT=$2; NEXT_SUBJECT=$3
fi

render() {
  local minor tag date subject kind
  echo "# Changelog"
  echo
  echo "Releases are signed tags applied by the GitOps agent (docs/versioning.md). Generated by"
  echo '`scripts/changelog` from the tag annotations; the summaries are in `docs/changelog/`.'
  for minor in $({ git tag -l 'v*'; [ -z "$NEXT" ] || echo "$NEXT"; } | sed -nE 's/^v([0-9]+\.[0-9]+)\.[0-9]+$/\1/p' | sort -u -t. -k1,1nr -k2,2nr); do
    [ -f "docs/changelog/$minor.md" ] || { echo "changelog: no summary for $minor (docs/changelog/$minor.md)" >&2; return 1; }
    echo
    echo "## $minor"
    echo
    cat "docs/changelog/$minor.md"
    echo
    [ -n "$NEXT" ] && [ "${NEXT%.*}" = "v$minor" ] && echo "- \`$NEXT\` $(date +%F): $NEXT_SUBJECT"
    git for-each-ref --sort=-version:refname --format='%(refname:short)|%(objecttype)|%(taggerdate:short)|%(contents:subject)' "refs/tags/v$minor.*" \
      | while IFS='|' read -r tag kind date subject; do
          [[ "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || continue
          [ "$kind" = tag ] || { echo "changelog: $tag is not an annotated tag" >&2; exit 1; }
          echo "- \`$tag\` $date: ${subject#"$tag: "}"
        done
  done
}

if [ "${1:-}" = --check ]; then
  diff -u CHANGELOG.md <(render) > /dev/null && { echo "CHANGELOG.md is up to date"; exit 0; }
  echo "CHANGELOG.md differs from the tags: scripts/changelog > CHANGELOG.md"; exit 1
fi
render
