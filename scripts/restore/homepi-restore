#!/bin/bash
# homepi-restore: run the restore phases R0 to R6 (docs/runbooks/restore.md) from the laptop, in order,
# and time each one. It stops only where a person must act (disk swap, microSD, the R1 device name and
# LUKS passphrase, key and signing passphrases) and records that wait apart, so the RTO is measured,
# not reconstructed from shell history (C3, 2026-11-21).
#
#   scripts/restore/homepi-restore start [--day YYYY-MM-DD] [--devices N] [--model "990 PRO"]
#   scripts/restore/homepi-restore resume      continue a drill after a stop (failed phase first)
#   scripts/restore/homepi-restore report      print the timeline and the RTO/RPO of the drill
#   scripts/restore/homepi-restore plan        list the phases, run nothing
#
# A drill lives in ~/homepi-restore/drill-<start>/ (timeline.tsv, drill.env, one log per phase).
# Phases already "ok" in the timeline are skipped on resume; a failed phase is retried.
# R7 and R8 stay manual: they end the drill and bring production back (restore.md).
set -uo pipefail
umask 077
export LC_ALL=C

ROOT_DIR="$HOME/homepi-restore"
CURRENT="$ROOT_DIR/current-drill"
AGE_KEY="$HOME/.config/sops/age/keys.txt"
KH_SD="$HOME/.ssh/known_hosts.drill-sd"
KH_NEW="$HOME/.ssh/known_hosts.drill-new"
PI=homepi
REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)

# id kind description; kind "human" waits for a person, "auto" runs alone (a prompt inside an auto
# phase, such as a passphrase, counts as machine time: it is part of running the step)
PHASES="R0 auto fetch and prove the backups (homepi-r0-fetch)
T0 human production powered off: the disk is dead from here
SD human spare disk in, microSD in, Pi booted from the microSD
SDCHECK auto the microSD system runs and sees only the spare disk
R1 auto lay out the spare disk (homepi-r1-layout: device name and LUKS passphrase typed)
BOOT human microSD out, Pi booted from the spare disk
BOOTCHECK auto the rebuilt system answers and runs from the spare disk
R2 auto packages and service accounts (restore-base.yml)
R3 auto state archive streamed into RAM and restored (homepi-r3-restore)
R5 auto InfluxDB native backup restored (homepi-r5-influx)
R35 auto services started (restore-services.yml)
R4KEY auto new age key on the Pi, public key only to the laptop
R4SOPS auto drill key added to .sops.yaml, data keys updated, signed commit
R4STORAGE auto boot-critical storage files (storage.yml)
R4SITE auto full apply, GitOps timers off (site.yml)
R4TAG auto signed release tag, precheck on the rebuilt Pi
R4APPLY auto GitOps applies the tag once, then owns the Pi
R6 auto read-only verification (homepi-r6-verify)"

die() { echo "STOPPED: $*" >&2; exit 1; }
log() { echo "homepi-restore: $*"; }
now() { date +%s; }
hms() { local s=$1; printf '%dh%02dm%02ds' $((s / 3600)) $((s % 3600 / 60)) $((s % 60)); }
stamp() { date -d "@$1" '+%Y-%m-%d %H:%M:%S %Z'; }
phase_ids() { printf '%s\n' "$PHASES" | awk '{print $1}'; }
phase_kind() { printf '%s\n' "$PHASES" | awk -v p="$1" '$1 == p {print $2}'; }
phase_desc() { printf '%s\n' "$PHASES" | awk -v p="$1" '$1 == p {$1 = ""; $2 = ""; sub(/^  /, ""); print}'; }

# ---------------------------------------------------------------- drill state
load_drill() {
  [ -L "$CURRENT" ] || die "no drill in progress (start one with: homepi-restore start)"
  DRILL=$(readlink -f "$CURRENT")
  # shellcheck source=/dev/null
  . "$DRILL/drill.env"
}

setvar() {  # persist one variable of the drill (values never hold a secret)
  local k=$1 v=$2
  grep -v "^$k=" "$DRILL/drill.env" > "$DRILL/drill.env.new"
  printf '%s=%q\n' "$k" "$v" >> "$DRILL/drill.env.new"
  mv "$DRILL/drill.env.new" "$DRILL/drill.env"
  printf -v "$k" '%s' "$v"
}

result_of() { awk -F'\t' -v p="$1" '$1 == p {r = $6} END {print r}' "$DRILL/timeline.tsv"; }

# Runs one phase, appends one line to the timeline: phase kind start end seconds result
run_phase() {
  local p=$1 kind start end rc
  kind=$(phase_kind "$p")
  if [ "$(result_of "$p")" = ok ]; then log "$p already done, skipped"; return 0; fi
  # The phase runs in a pipeline (a subshell): what earlier phases stored comes back from the file
  # shellcheck source=/dev/null
  . "$DRILL/drill.env"
  echo
  echo "=== $p: $(phase_desc "$p")"
  start=$(now)
  "phase_$p" 2>&1 | tee -a "$DRILL/$p.log"
  rc=${PIPESTATUS[0]}
  end=$(now)
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$p" "$kind" "$start" "$end" $((end - start)) "$([ "$rc" = 0 ] && echo ok || echo "failed rc=$rc")" >> "$DRILL/timeline.tsv"
  [ "$rc" = 0 ] || { echo "=== $p FAILED after $(hms $((end - start))) (log: $DRILL/$p.log). Fix it, then: homepi-restore resume"; return 1; }
  echo "=== $p ok in $(hms $((end - start)))"
}

# A person acts; the phase ends when they type the word
human() {
  local word=$1 msg=$2 ans
  echo "$msg"
  while :; do
    read -r -p "Type $word when done: " ans < /dev/tty || return 1
    [ "$ans" = "$word" ] && return 0
  done
}

# ---------------------------------------------------------------- SSH
pi_addr() { ssh -G "$PI" | awk '$1 == "hostname" {print $2; exit}'; }

# The sshd banner answers without any login: a passphrase-protected key cannot log in in BatchMode
wait_banner() {
  local a t0 b
  t0=$(now)
  a=$(pi_addr)
  while :; do
    # OpenSSH only: an initramfs unlock server (dropbear) also says SSH-2.0, with another host key
    b=$(timeout 5 bash -c "exec 3<> /dev/tcp/$a/22 && head -c 15 <&3" 2>&1) || true
    [ "$b" = "SSH-2.0-OpenSSH" ] && { log "sshd answers on $a:22 after $(hms $(( $(now) - t0 )))"; return 0; }
    [ $(( ($(now) - t0) % 60 )) -lt 5 ] && log "waiting for sshd on $a:22 ($(hms $(( $(now) - t0 ))))"
    sleep 5
  done
}

# One master connection per system; Ansible reuses it (ansible.cfg: same ControlPath, BatchMode).
# The key passphrase is typed once per master. Host keys: the microSD system and the rebuilt system
# each get their own known_hosts file; the usual one is never changed.
master() {
  local kh=$1
  ssh -O check "$PI" > /dev/null 2>&1 && return 0
  if [ -n "$kh" ]; then
    ssh -o UserKnownHostsFile="$kh" -o StrictHostKeyChecking=accept-new "$PI" true < /dev/tty
  else
    ssh "$PI" true < /dev/tty
  fi
}
drop_master() { ssh -O check "$PI" > /dev/null 2>&1 && ssh -O exit "$PI"; return 0; }

# After R3 the Pi has the production host keys, but the running sshd keeps the new ones until it
# restarts: try the usual known_hosts first, then the rebuild one
master_rebuilt() {
  ssh -O check "$PI" > /dev/null 2>&1 && return 0
  if [ "${R3_DONE:-0}" = 1 ] && master ""; then return 0; fi
  master "$KH_NEW"
}

disk_model() { ssh "$PI" 'd=$(lsblk -no PKNAME "$(findmnt -no SOURCE /)"); sed "s/ *$//" "/sys/block/$d/device/model"' < /dev/null; }

# ---------------------------------------------------------------- phases
phase_R0() {
  local out dir
  out=$("$REPO/scripts/restore/homepi-r0-fetch" ${DAY:+"$DAY"} | tee /dev/stderr) || return 1
  dir=$(printf '%s\n' "$out" | sed -n 's/^homepi-r0: R0 done: \(.*\) (encrypted.*/\1/p')
  [ -d "$dir" ] || { echo "R0 output names no directory"; return 1; }
  setvar BACKUP_DIR "$dir"
  setvar STATE "$(ls -t "$dir"/homepi-state-*.tar.age | head -n 1)"
  setvar NATIVE "$(ls -t "$dir"/influx-native-*.tar.age | head -n 1)"
  [ -f "$STATE" ] && [ -f "$NATIVE" ] || { echo "archives not found in $dir"; return 1; }
  log "state archive $(basename "$STATE"), native backup $(basename "$NATIVE")"
}

phase_T0() {
  local ans m
  master "" || return 1
  m=$(disk_model) || return 1
  echo "running Pi root disk: $m"
  [ -n "$m" ] && [ "$m" != "$MODEL" ] || { echo "the running Pi is not production: T0 powers off production"; return 1; }
  read -r -p "Type POWEROFF to power off production now (T0): " ans < /dev/tty
  [ "$ans" = POWEROFF ] || { echo "not confirmed"; return 1; }
  setvar T0 "$(now)"
  ssh "$PI" 'sudo systemctl poweroff' < /dev/null || true
  drop_master
  log "T0 = $(stamp "$T0")"
}

phase_SD() {
  human SD "Once the power LED is off: unplug, remove the production disk (bag, label PRODUCTION),
insert the $MODEL and the microSD, power on."
}

phase_SDCHECK() {
  wait_banner && master "$KH_SD" || return 1
  local root disks
  root=$(ssh "$PI" 'findmnt -no SOURCE /' < /dev/null)
  disks=$(ssh "$PI" 'lsblk -dn -o NAME,MODEL | grep "^nvme"' < /dev/null)
  echo "root: $root"; echo "NVMe: $disks"
  case "$root" in /dev/mmcblk*) ;; *) echo "root is not on the microSD"; return 1 ;; esac
  [ "$(printf '%s\n' "$disks" | grep -c .)" = 1 ] && printf '%s\n' "$disks" | grep -qF "$MODEL" \
    || { echo "expected exactly one NVMe, the $MODEL"; return 1; }
  printf '%s\n' "$disks" | grep -qi micron && { echo "a Micron is visible: remove it"; return 1; }
  return 0
}

phase_R1() {
  master "$KH_SD" || return 1
  git -C "$REPO" archive --format=tar HEAD \
    | ssh "$PI" 'sudo rm -rf /root/r1 && sudo install -d -m 0700 /root/r1/homepi-infra && sudo tar -x -C /root/r1/homepi-infra' || return 1
  ssh "$PI" 'sudo install -m 0600 "$HOME/.ssh/authorized_keys" /root/r1/authorized_keys' < /dev/null || return 1
  ssh -t "$PI" "sudo /root/r1/homepi-infra/scripts/restore/homepi-r1-layout --target /dev/nvme0n1 \
    --expect-model '$MODEL' --authorized-keys /root/r1/authorized_keys --repo /root/r1/homepi-infra" || return 1
  ssh "$PI" 'sudo systemctl poweroff' < /dev/null || true
  drop_master
}

phase_BOOT() {
  human BOOT "Once the power LED is off: unplug, REMOVE THE microSD, power on.
If the boot waits for the cryptdata passphrase, unlock it as in C3."
}

phase_BOOTCHECK() {
  wait_banner && master "$KH_NEW" || return 1
  local m
  m=$(disk_model) || return 1
  echo "root disk: $m"
  [ "$m" = "$MODEL" ] || { echo "the rebuilt system does not run from the $MODEL"; return 1; }
  ssh "$PI" 'findmnt -no SOURCE /var/lib/influxdb /mnt/data' < /dev/null || { echo "data volumes not mounted"; return 1; }
}

phase_R2() {
  master_rebuilt || return 1
  (cd "$REPO/ansible" && ansible-playbook restore-base.yml) < /dev/null
}

phase_R3() {
  master_rebuilt || return 1
  age -d -i "$AGE_KEY" "$STATE" | "$REPO/scripts/restore/homepi-r3-restore" --check || return 1
  ssh "$PI" 'rm -rf /tmp/homepi-r3 && install -d -m 0700 /tmp/homepi-r3' < /dev/null || return 1
  scp -q "$REPO/scripts/restore/homepi-r3-restore" "$REPO/scripts/restore/r3-paths.txt" \
    "$REPO/scripts/restore/homepi-r5-influx" "$REPO/ansible/roles/influxdb/files/config.toml" "$PI:/tmp/homepi-r3/" || return 1
  age -d -i "$AGE_KEY" "$STATE" | ssh "$PI" 'sudo /tmp/homepi-r3/homepi-r3-restore' || return 1
  setvar R3_DONE 1
}

phase_R5() {
  master_rebuilt || return 1
  age -d -i "$AGE_KEY" "$NATIVE" | ssh "$PI" 'sudo /tmp/homepi-r3/homepi-r5-influx /tmp/homepi-r3/config.toml'
}

phase_R35() {
  master_rebuilt || return 1
  (cd "$REPO/ansible" && ansible-playbook restore-services.yml) < /dev/null
}

phase_R4KEY() {
  master_rebuilt || return 1
  ssh "$PI" 'sudo install -d -m 0700 /etc/homepi-gitops && { sudo test -e /etc/homepi-gitops/age.key \
    || { sudo age-keygen -o /etc/homepi-gitops/age.key > /dev/null && sudo chmod 0600 /etc/homepi-gitops/age.key; }; }' < /dev/null || return 1
  local k
  k=$(ssh "$PI" 'sudo age-keygen -y /etc/homepi-gitops/age.key' < /dev/null) || return 1
  [[ "$k" =~ ^age1[0-9a-z]{58}$ ]] || { echo "unexpected public key format"; return 1; }
  setvar DRILL_AGE_PUB "$k"
  log "drill Pi public key: $k"
}

phase_R4SOPS() {
  cd "$REPO" || return 1
  [ "$(git branch --show-current)" = main ] || { echo "the repository is not on main"; return 1; }
  if ! grep -qF "$DRILL_AGE_PUB" .sops.yaml; then
    # Add, never replace: production must still decrypt when its disk comes back
    sed -i "s|^\(    age: .*\)$|\1,$DRILL_AGE_PUB|" .sops.yaml
    grep -qF "$DRILL_AGE_PUB" .sops.yaml || { echo ".sops.yaml: the key was not added"; return 1; }
  fi
  local f
  for f in ansible/secrets/*.sops.yaml; do sops updatekeys -y "$f" || return 1; done
  git add .sops.yaml ansible/secrets/ || return 1
  if git diff --cached --quiet; then log "nothing to commit (already added)"; return 0; fi
  git commit -S -q -m "$SOPS_SUBJECT" -m "Temporary: removed in R8 with sops updatekeys and sops rotate." < /dev/tty
}

phase_R4STORAGE() {
  master_rebuilt || return 1
  (cd "$REPO/ansible" && ansible-playbook storage.yml --check --diff && ansible-playbook storage.yml) < /dev/null
}

phase_R4SITE() {
  master_rebuilt || return 1
  (cd "$REPO/ansible" && ansible-playbook site.yml -e gitops_timers_enabled=false) < /dev/null
}

next_tag() {
  local last
  last=$(git -C "$REPO" tag -l 'v0.1.*' --sort=-v:refname | head -n 1)
  [[ "$last" =~ ^v0\.1\.([0-9]+)$ ]] || return 1
  echo "v0.1.$((BASH_REMATCH[1] + 1))"
}

phase_R4TAG() {
  master_rebuilt || return 1
  local tag
  tag=$(next_tag) || { echo "cannot compute the next tag"; return 1; }
  setvar DRILL_TAG "$tag"
  # shellcheck source=/dev/null
  . "$REPO/scripts/lib.sh"
  # release reuses the R4SOPS commit (same subject) and runs the precheck on the rebuilt Pi
  release "$SOPS_SUBJECT" "" "$tag" "Restore drill: the rebuilt Pi takes over through GitOps" < /dev/tty
}

phase_R4APPLY() {
  master_rebuilt || return 1
  ssh "$PI" 'sudo systemctl start --no-block homepi-gitops@apply' < /dev/null || return 1
  sleep 5
  while [ "$(ssh "$PI" 'systemctl is-active homepi-gitops@apply' < /dev/null)" = activating ]; do sleep 15; done
  local r deployed
  r=$(ssh "$PI" 'systemctl show -p Result --value homepi-gitops@apply' < /dev/null)
  deployed=$(ssh "$PI" 'sudo cat /var/lib/homepi-gitops/deployed' < /dev/null | awk '{print $1}')
  echo "GitOps result: $r, deployed: $deployed"
  [ "$r" = success ] && [ "$deployed" = "$DRILL_TAG" ]
}

phase_R6() {
  master_rebuilt || return 1
  scp -q "$REPO/scripts/restore/homepi-r6-verify" "$PI:/tmp/homepi-r6-verify" || return 1
  ssh -t "$PI" "sudo bash /tmp/homepi-r6-verify $DEVICES; rc=\$?; rm -f /tmp/homepi-r6-verify; exit \$rc"
}

# ---------------------------------------------------------------- report
# The archive names carry the local time of the Pi (JST): homepi-state-YYYY-MM-DD-HHMM[SS].tar.age
archive_epoch() {
  local n
  n=$(basename "$1" | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{4,6}') || return 1
  local d=${n:0:10} t=${n:11}
  [ ${#t} = 4 ] && t="${t}00"
  TZ=Asia/Tokyo date -d "$d ${t:0:2}:${t:2:2}:${t:4:2}" +%s
}

report() {
  local human_s=0 auto_s=0 last_end="" r6 p kind s e sec res
  printf '%-10s %-6s %-21s %-21s %10s  %s\n' phase kind start end duration result
  while IFS=$'\t' read -r p kind s e sec res; do
    printf '%-10s %-6s %-21s %-21s %10s  %s\n' "$p" "$kind" "$(date -d "@$s" '+%m-%d %H:%M:%S')" "$(date -d "@$e" '+%m-%d %H:%M:%S')" "$(hms "$sec")" "$res"
    [ "$res" = ok ] || continue
    if [ "$kind" = human ]; then human_s=$((human_s + sec)); else auto_s=$((auto_s + sec)); fi
    last_end=$e
  done < "$DRILL/timeline.tsv"
  echo
  [ -n "${T0:-}" ] || { echo "T0 not reached yet"; return 0; }
  echo "T0 (production off): $(stamp "$T0")"
  r6=$(awk -F'\t' '$1 == "R6" && $6 == "ok" {e = $4} END {print e}' "$DRILL/timeline.tsv")
  if [ -n "$r6" ]; then
    echo "RTO (T0 to R6 PASS): $(hms $((r6 - T0)))"
  else
    echo "RTO: not measured yet (R6 has not passed); elapsed since T0: $(hms $(( ${last_end:-$T0} - T0 )))"
  fi
  echo "time in ok phases: machine $(hms "$auto_s"), waiting for a person $(hms "$human_s") (failed attempts count only in the RTO)"
  local a
  for f in "${STATE:-}" "${NATIVE:-}"; do
    [ -n "$f" ] || continue
    a=$(archive_epoch "$f") && echo "RPO $(basename "$f"): $(hms $((T0 - a))) (archive time from its name, JST)"
  done
}

# ---------------------------------------------------------------- main
usage() { sed -n '2,15p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 2; }

main() {
  local cmd=${1:-}; shift || true
  case "$cmd" in
    plan) printf '%s\n' "$PHASES" | awk '{k = $2; $2 = ""; printf "%-10s %-6s %s\n", $1, k, substr($0, length($1) + 3)}'; exit 0 ;;
    report) load_drill; report; exit 0 ;;
    start)
      [ "$(hostname)" = "DESKTOP-581OMPC" ] || die "run this on the laptop"
      local day="" devices=7 model="990 PRO"
      while [ $# -gt 0 ]; do
        case "$1" in
          --day) day=$2; shift 2 ;;
          --devices) devices=$2; shift 2 ;;
          --model) model=$2; shift 2 ;;
          *) usage ;;
        esac
      done
      [ -z "$day" ] || [[ "$day" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || die "--day must be YYYY-MM-DD"
      [[ "$devices" =~ ^[0-9]+$ ]] || die "--devices must be a number"
      if [ -L "$CURRENT" ]; then
        load_drill
        [ "$(result_of R6)" = ok ] || die "a drill is in progress ($DRILL): resume it, or remove $CURRENT to abandon it"
      fi
      install -d -m 0700 "$ROOT_DIR" || die "cannot create $ROOT_DIR"
      DRILL="$ROOT_DIR/drill-$(date +%Y%m%d-%H%M)"
      install -d -m 0700 "$DRILL" || die "cannot create $DRILL"
      : > "$DRILL/timeline.tsv"
      : > "$DRILL/drill.env"
      setvar DAY "$day"; setvar DEVICES "$devices"; setvar MODEL "$model"
      setvar SOPS_SUBJECT "chore(sops): add the restore drill Pi age key ($(basename "$DRILL"), temporary)"
      ln -sfn "$DRILL" "$CURRENT"
      log "drill $DRILL" ;;
    resume)
      [ "$(hostname)" = "DESKTOP-581OMPC" ] || die "run this on the laptop"
      load_drill ;;
    *) usage ;;
  esac
  for c in age sops ansible-playbook git scp ssh timeout; do command -v "$c" > /dev/null || die "missing command: $c"; done
  [ -r "$AGE_KEY" ] || die "laptop age key not found ($AGE_KEY)"
  local p
  for p in $(phase_ids); do
    run_phase "$p" || { echo; report; exit 1; }
  done
  echo
  report
  echo
  echo "Next, by hand: R7 (homepi-r7-end-drill) and R8, production back (docs/runbooks/restore.md)."
}

[ "${BASH_SOURCE[0]}" = "$0" ] && main "$@"
