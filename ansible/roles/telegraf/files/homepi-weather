#!/usr/bin/env python3
"""Hourly weather at home, observed by JMA AMeDAS -> InfluxDB line protocol (Telegraf inputs.exec).
docs/runbooks/weather.md.

Privacy: the location never leaves the Pi. Every request is for a file that is the same for everyone
(the national station table, and one file per time holding every AMeDAS station of Japan); the nearest
stations are chosen here, from the location in Telegraf's environment (HOMEPI_WEATHER_LAT / _LON, SOPS).
Sunrise and sunset are computed here (NOAA solar position), with no request at all.

Measurements (bucket iot-hot through Telegraf; the hourly Influx task copies them to iot-archives):
  weather        one point per hour, stamped at the hour start: precip (mm, the hour), sun (h of sunshine in
                 the hour), temp (C, at the hour end), is_day, dist_km (farthest station used), and code (a WMO
                 weather code derived from the observations, see derive_code) when one can be told
  weather_daily  one point per local day (00:00 Asia/Tokyo): sunrise, sunset (Unix seconds)
What cannot be observed is left out, never guessed: cloud cover is not measured, so a dry night hour has
no code (the dashboard shows no icon for it).

Local archive: every national file fetched is also kept, gzipped and unchanged, under ARCHIVE
(/var/lib/homepi/weather/amedas/YYYY/MM/DDHH.json.gz, and the station table each time it changes). JMA keeps
these files only a few days; the archive lets the weather be recomputed later (a better rule, more fields,
another location) without asking JMA anything. --reprocess reads it instead of the network.

Usage:
  homepi-weather                        live: the hours not written yet (state file), at most the last 24
  homepi-weather --backfill START END   past days (YYYY-MM-DD, inclusive), as far as JMA still serves them,
                                        for a one-time `influx write` into iot-archives
  homepi-weather --reprocess START END  the same days from the local archive only (no network)
"""
import datetime as dt, glob, gzip, hashlib, json, math, os, sys, time, urllib.error, urllib.request

BASE = "https://www.jma.go.jp/bosai/amedas"
JST = dt.timezone(dt.timedelta(hours=9))
UA = {"User-Agent": "homepi-weather/2 (home energy dashboard; hourly)"}
STATE = os.environ.get("HOMEPI_WEATHER_STATE", "/var/lib/homepi/weather/state.json")
ARCHIVE = os.environ.get("HOMEPI_WEATHER_ARCHIVE", "/var/lib/homepi/weather/amedas")
ELEMS = ("precipitation1h", "sun1h", "temp")


def location(env=os.environ):
    try:
        lat, lon = float(env["HOMEPI_WEATHER_LAT"]), float(env["HOMEPI_WEATHER_LON"])
    except (KeyError, ValueError):
        raise SystemExit("homepi-weather: HOMEPI_WEATHER_LAT / HOMEPI_WEATHER_LON missing or not numbers")
    if not (20 <= lat <= 46 and 122 <= lon <= 154):
        raise SystemExit("homepi-weather: location outside Japan (AMeDAS covers Japan only)")
    return lat, lon


def fetch_bytes(url, timeout=20):
    with urllib.request.urlopen(urllib.request.Request(url, headers=UA), timeout=timeout) as r:
        return r.read()


def fetch_json(url, timeout=20):
    return json.loads(fetch_bytes(url, timeout))


# ── Local archive of the national files ───────────────────────────────────────────────────────────
def archive_path(hour_end):
    h = hour_end.astimezone(JST)
    return os.path.join(ARCHIVE, f"{h:%Y}", f"{h:%m}", f"{h:%d%H}.json.gz")


def archive_write(path, raw):
    """Keep a file as JMA served it (gzip). Best effort: a full or read-only disk never stops the weather."""
    if not ARCHIVE or os.path.exists(path):
        return
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = path + ".tmp"
        with gzip.open(tmp, "wb", compresslevel=9) as f:
            f.write(raw)
        os.replace(tmp, path)
    except OSError as e:
        print(f"homepi-weather: archive not written ({e})", file=sys.stderr)


def archive_table(raw):
    """Station table, kept each time its content changes (needed to read old files: stations move or close)."""
    if not ARCHIVE:
        return
    digest = hashlib.sha256(raw).hexdigest()[:12]
    if glob.glob(os.path.join(ARCHIVE, "tables", f"amedastable-*-{digest}.json.gz")):
        return
    archive_write(os.path.join(ARCHIVE, "tables", f"amedastable-{dt.datetime.now(JST):%Y%m%d}-{digest}.json.gz"), raw)


def archived_table(day):
    """Newest archived station table from on or before `day` (or the oldest one there is)."""
    files = sorted(glob.glob(os.path.join(ARCHIVE, "tables", "amedastable-*.json.gz")))
    if not files:
        raise SystemExit(f"homepi-weather: no station table in {ARCHIVE}/tables")
    older = [f for f in files if os.path.basename(f).split("-")[1] <= f"{day:%Y%m%d}"]
    with gzip.open((older or files)[-1]) as f:
        return json.load(f)


def fetch_text(url, timeout=20):
    with urllib.request.urlopen(urllib.request.Request(url, headers=UA), timeout=timeout) as r:
        return r.read().decode()


def map_url(hour):
    return f"{BASE}/data/map/{hour.astimezone(JST):%Y%m%d%H%M%S}.json"


# ── Stations ───────────────────────────────────────────────────────────────────────────────────────
def deg(v):
    """amedastable lat/lon: [degrees, minutes]"""
    return v[0] + v[1] / 60


def dist_km(lat1, lon1, lat2, lon2):
    p1, p2, dl = math.radians(lat1), math.radians(lat2), math.radians(lon2 - lon1)
    a = math.sin((p2 - p1) / 2) ** 2 + math.cos(p1) * math.cos(p2) * math.sin(dl / 2) ** 2
    return 6371 * 2 * math.asin(math.sqrt(a))


def value(obs, sid, elem):
    v = (obs.get(sid) or {}).get(elem)
    return v[0] if isinstance(v, list) and v and isinstance(v[0], (int, float)) else None


def nearest(table, obs, lat, lon, elem, max_km=40):
    """Nearest station that has a value for elem in this observation file (stations differ in what they
    measure, and a station can miss an hour): (id, km) or None."""
    best = None
    for sid, st in table.items():
        if value(obs, sid, elem) is None:
            continue
        try:
            d = dist_km(lat, lon, deg(st["lat"]), deg(st["lon"]))
        except (KeyError, TypeError, IndexError):
            continue
        if d <= max_km and (best is None or d < best[1]):
            best = (sid, d)
    return best


# ── Sun ────────────────────────────────────────────────────────────────────────────────────────────
def sun_times(lat, lon, day):
    """Sunrise and sunset (Unix seconds) of a calendar date, NOAA approximation (about a minute).
    None for polar day or night (not in Japan)."""
    n = day.timetuple().tm_yday
    g = 2 * math.pi / 365 * (n - 1 + 0.5)
    eqt = 229.18 * (0.000075 + 0.001868 * math.cos(g) - 0.032077 * math.sin(g) - 0.014615 * math.cos(2 * g) - 0.040849 * math.sin(2 * g))
    decl = (0.006918 - 0.399912 * math.cos(g) + 0.070257 * math.sin(g) - 0.006758 * math.cos(2 * g) + 0.000907 * math.sin(2 * g)
            - 0.002697 * math.cos(3 * g) + 0.00148 * math.sin(3 * g))
    la = math.radians(lat)
    c = math.cos(math.radians(90.833)) / (math.cos(la) * math.cos(decl)) - math.tan(la) * math.tan(decl)
    if abs(c) > 1:
        return None
    ha = math.degrees(math.acos(c))
    utc0 = dt.datetime(day.year, day.month, day.day, tzinfo=dt.timezone.utc).timestamp()
    return utc0 + (720 - 4 * (lon + ha) - eqt) * 60, utc0 + (720 - 4 * (lon - ha) - eqt) * 60


def daylight_minutes(start_s, lat, lon):
    """Minutes of the hour [start, start + 1 h) between sunrise and sunset"""
    st = sun_times(lat, lon, dt.datetime.fromtimestamp(start_s, JST).date())
    if not st:
        return 0
    return max(0.0, min(start_s + 3600, st[1]) - max(start_s, st[0])) / 60


# ── Weather code ───────────────────────────────────────────────────────────────────────────────────
def derive_code(precip, temp, sun_h, day_min):
    """WMO code from what AMeDAS measures. Precipitation >= 0.5 mm (the gauge resolution) in the hour: rain,
    or snow at 1.5 C or below (a rule of thumb: sleet near the threshold can go either way). Otherwise, with
    at least 30 min of daylight: sunshine over the daylight part of the hour gives clear (>= 70%), partly
    cloudy (>= 20%) or cloudy. A dry hour without enough daylight: None (cloud cover is not observed)."""
    if precip is not None and precip >= 0.5:
        if temp is not None and temp <= 1.5:
            return 71 if precip < 1 else 73 if precip < 3 else 75
        return 61 if precip < 3 else 63 if precip < 10 else 65
    if day_min >= 30 and sun_h is not None:
        frac = min(1.0, sun_h * 60 / day_min)
        return 0 if frac >= 0.7 else 2 if frac >= 0.2 else 3
    return None


def hour_line(obs, table, hour_end_s, lat, lon):
    """One weather point from the observation file of hour_end (its 1 h totals cover the hour before)."""
    start = hour_end_s - 3600
    picks = {e: nearest(table, obs, lat, lon, e) for e in ELEMS}
    precip = value(obs, picks["precipitation1h"][0], "precipitation1h") if picks["precipitation1h"] else None
    sun = value(obs, picks["sun1h"][0], "sun1h") if picks["sun1h"] else None
    temp = value(obs, picks["temp"][0], "temp") if picks["temp"] else None
    if precip is None and sun is None and temp is None:
        return None
    day_min = daylight_minutes(start, lat, lon)
    code = derive_code(precip, temp, sun, day_min)
    f = []
    if code is not None: f.append(f"code={code}i")
    if precip is not None: f.append(f"precip={precip:.1f}")
    if sun is not None: f.append(f"sun={sun:.2f}")
    if temp is not None: f.append(f"temp={temp:.1f}")
    f.append(f"is_day={1 if day_min >= 30 else 0}i")
    f.append(f"dist_km={max(p[1] for p in picks.values() if p):.1f}")
    return f"weather,source=jma-amedas {','.join(f)} {int(start)}000000000"


def daily_lines(lat, lon, days):
    out = []
    for day in days:
        st = sun_times(lat, lon, day)
        if st:
            t0 = dt.datetime(day.year, day.month, day.day, tzinfo=JST).timestamp()
            out.append(f"weather_daily,source=local sunrise={int(st[0])}i,sunset={int(st[1])}i {int(t0)}000000000")
    return out


def load_state():
    try:
        with open(STATE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_state(s):
    try:
        tmp = STATE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(s, f)
        os.replace(tmp, STATE)
    except OSError as e:
        print(f"homepi-weather: state not saved ({e}): the next run fetches the last 24 h again", file=sys.stderr)


def station_table(state, today):
    """National station table, refreshed once a day (same file for everyone)."""
    if state.get("table") and state.get("table_day") == today:
        return state["table"]
    raw = fetch_bytes(f"{BASE}/const/amedastable.json")
    archive_table(raw)
    table = json.loads(raw)
    state["table"], state["table_day"] = table, today
    return table


def hours_between(first_end_s, last_end_s):
    return list(range(int(first_end_s), int(last_end_s) + 1, 3600))


def run(hour_ends, table, lat, lon, offline=False):
    lines, missing = [], 0
    for end in hour_ends:
        when = dt.datetime.fromtimestamp(end, JST)
        path = archive_path(when)
        try:
            if offline:
                with gzip.open(path) as f:
                    obs = json.load(f)
            else:
                raw = fetch_bytes(map_url(when))
                archive_write(path, raw)
                obs = json.loads(raw)
        except FileNotFoundError:      # offline: that hour was never archived
            missing += 1
            continue
        except urllib.error.HTTPError as e:
            if e.code == 404:          # not published yet, or no longer kept by JMA
                missing += 1
                continue
            raise
        line = hour_line(obs, table, end, lat, lon)
        if line:
            lines.append(line)
    return lines, missing


def main(argv):
    lat, lon = location()
    now = dt.datetime.now(JST)
    try:
        if len(argv) == 4 and argv[1] in ("--backfill", "--reprocess"):
            offline = argv[1] == "--reprocess"
            d0, d1 = dt.date.fromisoformat(argv[2]), dt.date.fromisoformat(argv[3])
            if offline:
                table = archived_table(d1)
            else:
                raw = fetch_bytes(f"{BASE}/const/amedastable.json")
                archive_table(raw)
                table = json.loads(raw)
            first = dt.datetime(d0.year, d0.month, d0.day, 1, tzinfo=JST).timestamp()
            last = dt.datetime(d1.year, d1.month, d1.day, tzinfo=JST).timestamp() + 86400
            lines, missing = run(hours_between(first, last), table, lat, lon, offline)
            lines += daily_lines(lat, lon, [d0 + dt.timedelta(days=i) for i in range((d1 - d0).days + 1)])
            print(f"homepi-weather: {argv[1][2:]} {len(lines)} lines, {missing} hours "
                  f"{'not in the archive' if offline else 'not served by JMA'}", file=sys.stderr)
        elif len(argv) == 1:
            state = load_state()
            table = station_table(state, now.date().isoformat())
            latest = dt.datetime.fromisoformat(fetch_text(f"{BASE}/data/latest_time.txt").strip())
            last_end = latest.replace(minute=0, second=0, microsecond=0).timestamp()
            first_end = max(state.get("last_end", 0) + 3600, last_end - 23 * 3600)
            lines, _ = run(hours_between(first_end, last_end), table, lat, lon)
            if lines:
                state["last_end"] = max(int(l.rsplit(" ", 1)[1]) // 10**9 for l in lines) + 3600
            save_state(state)
            lines += daily_lines(lat, lon, [now.date() - dt.timedelta(days=1), now.date()])
        else:
            print(__doc__, file=sys.stderr)
            return 2
    except Exception as e:   # network or JMA error: Telegraf logs it, the next run retries the same hours
        print(f"homepi-weather: {type(e).__name__}: {e}", file=sys.stderr)
        return 1
    sys.stdout.write("\n".join(lines) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
