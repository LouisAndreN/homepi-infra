#!/usr/bin/env python3
"""Hourly weather at home -> InfluxDB line protocol (Telegraf inputs.exec, docs/runbooks/weather.md).

Source: Open-Meteo (CC BY 4.0, no key). The location comes from SOPS through Telegraf's environment
(HOMEPI_WEATHER_LAT / HOMEPI_WEATHER_LON); it never appears in the repository or in the data.

Measurements (bucket iot-hot through Telegraf; the hourly Influx task copies them to iot-archives):
  weather        one point per past hour: code (WMO weather code), temp (C), precip (mm), cloud (%), is_day
  weather_daily  one point per local day (00:00 local): sunrise, sunset (Unix seconds)
Each run rewrites the last days at the same timestamps: the model analysis of an hour converges in place.
Only hours that have started are written: the dashboard shows the weather that happened, not a forecast.

Usage:
  homepi-weather                       live: the 2 previous days and today (Telegraf, every 15 min)
  homepi-weather --backfill START END  past days (YYYY-MM-DD, inclusive) from the historical forecast
                                       archive, for a one-time `influx write` into iot-archives
"""
import json, os, sys, time, urllib.parse, urllib.request

LIVE_URL = "https://api.open-meteo.com/v1/forecast"
ARCHIVE_URL = "https://historical-forecast-api.open-meteo.com/v1/forecast"
HOURLY = ["weather_code", "temperature_2m", "precipitation", "cloud_cover", "is_day"]
DAILY = ["sunrise", "sunset"]
TZ = "Asia/Tokyo"


def location(env=os.environ):
    """Latitude and longitude from the environment, rounded to 2 decimals (about 1 km)."""
    try:
        lat, lon = float(env["HOMEPI_WEATHER_LAT"]), float(env["HOMEPI_WEATHER_LON"])
    except (KeyError, ValueError):
        raise SystemExit("homepi-weather: HOMEPI_WEATHER_LAT / HOMEPI_WEATHER_LON missing or not numbers")
    if not (-90 <= lat <= 90 and -180 <= lon <= 180):
        raise SystemExit("homepi-weather: location out of range")
    return round(lat, 2), round(lon, 2)


def build_url(base, lat, lon, **extra):
    q = {"latitude": f"{lat:.2f}", "longitude": f"{lon:.2f}", "hourly": ",".join(HOURLY), "daily": ",".join(DAILY),
         "timezone": TZ, "timeformat": "unixtime", **extra}
    return f"{base}?{urllib.parse.urlencode(q)}"


def fetch(url, timeout=20):
    req = urllib.request.Request(url, headers={"User-Agent": "homepi-weather/1"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)


def _num(v):
    return v is not None and isinstance(v, (int, float))


def to_lines(doc, now_s):
    """Open-Meteo response -> line protocol. Hours not started yet and empty values are skipped."""
    out = []
    h = doc.get("hourly") or {}
    times = h.get("time") or []
    for i, t in enumerate(times):
        if t > now_s:
            continue
        val = lambda k: (h.get(k) or [None] * len(times))[i]
        code, temp, precip, cloud, is_day = (val(k) for k in HOURLY)
        if not _num(code):
            continue
        f = [f"code={int(code)}i"]
        if _num(temp): f.append(f"temp={float(temp):.1f}")
        if _num(precip): f.append(f"precip={float(precip):.2f}")
        if _num(cloud): f.append(f"cloud={int(cloud)}i")
        if _num(is_day): f.append(f"is_day={int(is_day)}i")
        out.append(f"weather,source=open-meteo {','.join(f)} {int(t)}000000000")
    d = doc.get("daily") or {}
    for i, t in enumerate(d.get("time") or []):
        rise, sset = (d.get("sunrise") or [None])[i:i + 1], (d.get("sunset") or [None])[i:i + 1]
        rise, sset = (rise[0] if rise else None), (sset[0] if sset else None)
        if t > now_s or not (_num(rise) and _num(sset)):
            continue
        out.append(f"weather_daily,source=open-meteo sunrise={int(rise)}i,sunset={int(sset)}i {int(t)}000000000")
    return out


def main(argv):
    lat, lon = location()
    now_s = int(time.time())
    if len(argv) == 4 and argv[1] == "--backfill":
        url = build_url(ARCHIVE_URL, lat, lon, start_date=argv[2], end_date=argv[3])
    elif len(argv) == 1:
        url = build_url(LIVE_URL, lat, lon, past_days=2, forecast_days=1)
    else:
        print(__doc__, file=sys.stderr)
        return 2
    try:
        doc = fetch(url)
    except Exception as e:   # network or API error: Telegraf logs it, the next run retries
        print(f"homepi-weather: fetch failed: {type(e).__name__}: {e}".replace(f"{lat:.2f}", "LAT").replace(f"{lon:.2f}", "LON"), file=sys.stderr)
        return 1
    lines = to_lines(doc, now_s)
    if not lines:
        print("homepi-weather: no data in the response", file=sys.stderr)
        return 1
    sys.stdout.write("\n".join(lines) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
