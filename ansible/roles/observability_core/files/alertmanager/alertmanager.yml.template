global:
  resolve_timeout: 5m

route:
  group_by: ['alertname', 'severity']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  receiver: 'slack-warning'
  routes:
    # Watchdog always fires. Repeated every minute to the heartbeat relay on the Pi, which publishes it
    # to CloudWatch: when it stops, an alarm e-mails from outside the Pi (dead man's switch)
    - matchers:
        - alertname = Watchdog
      receiver: 'heartbeat'
      group_wait: 0s
      # repeat_interval is only checked at each group_interval tick, so the real cadence is about
      # two ticks: 30s and 30s give about one heartbeat per minute (1m and 1m measured 2 min)
      group_interval: 30s
      repeat_interval: 30s
#    - matchers:
#        - severity = critical
#      receiver: 'pagerduty-critical'
#      repeat_interval: 1h
#      continue: true
    - matchers:
        - severity = critical
      receiver: 'slack-critical'
      repeat_interval: 1h
    - matchers:
        - severity = warning
      receiver: 'slack-warning'
      repeat_interval: 4h

receivers:
  - name: 'null'

  - name: 'heartbeat'
    webhook_configs:
      - url: 'http://127.0.0.1:9095/watchdog'
        send_resolved: false

#  - name: 'pagerduty-critical'
#    pagerduty_configs:
#      - routing_key: '${PAGERDUTY_INTEGRATION_KEY}'
#        severity: 'critical'
#        description: '{{ .GroupLabels.alertname }} - {{ .CommonAnnotations.summary }}'
#        details:
#          firing: '{{ .Alerts.Firing | len }}'
#          instance: '{{ .CommonLabels.instance }}'
#          description: '{{ .commonAnnotations.description }}'

  - name: 'slack-critical'
    slack_configs:
      - api_url: '${SLACK_WEBHOOK_CRITICAL}'
        channel: '#alerts-critical'
        icon_emoji: ':red_circle:'
        title: '[{{ .Status | toUpper }}] CRITICAL - {{ .GroupLabels.alertname }}'
        color: '{{ if eq .Status "firing" }}danger{{ else }}good{{ end }}'
        text: |
          *Summary:* {{ .CommonAnnotations.summary }}
          *Description:* {{ .CommonAnnotations.description }}
          *Severity:* {{ .CommonLabels.severity }}
        send_resolved: true

  - name: 'slack-warning'
    slack_configs:
      - api_url: '${SLACK_WEBHOOK_WARNING}'
        channel: '#alerts-warning'
        icon_emoji: ':warning:'
        title: '[{{ .Status | toUpper }}] WARNING - {{ .GroupLabels.alertname }}'
        color: '{{ if eq .Status "firing" }}danger{{ else }}good{{ end }}'
        text: |
          *Summary:* {{ .CommonAnnotations.summary }}
          *Description:* {{ .CommonAnnotations.description }}
        send_resolved: true

# An alert is inhibited only by the alert of what it really depends on: the target cannot be true
# while the source is firing, so it adds a notification and no information. An alert whose cause is
# only shared (the MQTT ACL sync reads devices.db directly, not through the API) is never inhibited.
# 2026-11-22 incident: 79 Slack notifications in one night for one cause. Test: tests/inhibit-test.
inhibit_rules:
  - source_matchers:
      - severity = critical
    target_matchers:
      - severity = warning
    equal: ['alertname']
  # A unit that is down is also failed or restarting: one alert per unit, the one that says what it serves
  - source_matchers:
      - alertname =~ "[A-Za-z]+Down"
    target_matchers:
      - alertname =~ "SystemdUnitFailed|SystemdServiceRestartLoop"
    equal: ['name']
  # Prometheus reads the device registry metrics on 127.0.0.1:3001: nginx, then homepi-api.service
  - source_matchers:
      - alertname = NginxDown
    target_matchers:
      - alertname = DevicesMetricsMissing
  - source_matchers:
      - alertname = HomepiApiDown
      - name = homepi-api.service
    target_matchers:
      - alertname = DevicesMetricsMissing
  # InfluxDB down: Telegraf cannot write, and the write counters are gone with it
  - source_matchers:
      - alertname = InfluxDBDown
    target_matchers:
      - alertname = InfluxWritesStopped
