#!/bin/bash
# Offline test of homepi-backup-influx-delta: annotated CSV -> line protocol, and the export window.
# The CSV is shaped like the InfluxDB 2 query API output (datatype annotation, blank line between
# tables, CRLF). Expected lines follow the line protocol escaping rules.
set -u
HERE=$(cd "$(dirname "$0")" && pwd)
CONV="$HERE/../files/sbin/homepi-backup-influx-delta"
T=$(mktemp -d); trap 'rm -rf "$T"' EXIT
printf '%s\r\n' \
  '#datatype,string,long,dateTime:RFC3339,dateTime:RFC3339,dateTime:RFC3339Nano,double,string,string,string,string' \
  ',result,table,_start,_stop,_time,_value,_field,_measurement,device_id,topic' \
  ',_result,0,2026-11-22T02:00:00Z,2026-11-22T03:05:00Z,2026-11-22T03:00:00.123456789Z,21.5,temperature,iot_sensors,esp32-0a171a18,iot/esp32-0a171a18/sensors' \
  ',_result,0,2026-11-22T02:00:00Z,2026-11-22T03:05:00Z,2026-11-22T03:00:10Z,NaN,temperature,iot_sensors,esp32-0a171a18,iot/esp32-0a171a18/sensors' \
  '' \
  '#datatype,string,long,dateTime:RFC3339,dateTime:RFC3339,dateTime:RFC3339,long,string,string,string,string' \
  ',result,table,_start,_stop,_time,_value,_field,_measurement,device_id,hw_model' \
  ',_result,1,2026-11-22T02:00:00Z,2026-11-22T03:05:00Z,2026-11-22T03:00:00Z,1763780400,ts,nilm_readings,esp32 a,"v1,b=2"' \
  ',_result,1,2026-11-22T02:00:00Z,2026-11-22T03:05:00Z,2026-11-22T03:00:01Z,-3,delta_P,nilm_readings,esp32 a,' \
  '' \
  '#datatype,string,long,dateTime:RFC3339,dateTime:RFC3339,dateTime:RFC3339,string,string,string,string' \
  ',result,table,_start,_stop,_time,_value,_field,_measurement,device_id' \
  ',_result,2,2026-11-22T02:00:00Z,2026-11-22T03:05:00Z,2026-11-22T03:00:02Z,"say ""hi"" \ ok",msg,my status,dev' \
  '' \
  '#datatype,string,long,dateTime:RFC3339,dateTime:RFC3339,dateTime:RFC3339,boolean,string,string' \
  ',result,table,_start,_stop,_time,_value,_field,_measurement' \
  ',_result,3,2026-11-22T02:00:00Z,2026-11-22T03:05:00Z,2026-11-22T03:00:03Z,true,event flag,m' \
  '' \
  '#datatype,string,long,dateTime:RFC3339,dateTime:RFC3339,dateTime:RFC3339,unsignedLong,string,string' \
  ',result,table,_start,_stop,_time,_value,_field,_measurement' \
  ',_result,4,2026-11-22T02:00:00Z,2026-11-22T03:05:00Z,2026-11-22T03:00:04Z,18446744073709551615,big,m' \
  > "$T/in.csv"
python3 -I "$CONV" --convert < "$T/in.csv" > "$T/out.lp" 2> "$T/err"
cat > "$T/want.lp" << 'WANT'
iot_sensors,device_id=esp32-0a171a18,topic=iot/esp32-0a171a18/sensors temperature=21.5 1795316400123456789
nilm_readings,device_id=esp32\ a,hw_model=v1\,b\=2 ts=1763780400i 1795316400000000000
nilm_readings,device_id=esp32\ a delta_P=-3i 1795316401000000000
my\ status,device_id=dev msg="say \"hi\" \\ ok" 1795316402000000000
m event\ flag=true 1795316403000000000
m big=18446744073709551615u 1795316404000000000
WANT
fails=0
if diff -u "$T/want.lp" "$T/out.lp"; then echo "ok   line protocol matches (escaping, types, nanoseconds, empty tag dropped)"; else echo "FAIL line protocol differs"; fails=1; fi
if grep -q "converted 6 points, skipped 1" "$T/err"; then echo "ok   NaN skipped and counted"; else echo "FAIL counts: $(cat "$T/err")"; fails=1; fi
printf '%s\n' ',result,table,_time,_value' ',_result,0,2026-11-22T03:00:00Z,1' > "$T/bad.csv"
if python3 -I "$CONV" --convert < "$T/bad.csv" > /dev/null 2>&1; then echo "FAIL a result without _field and _measurement was accepted"; fails=1; else echo "ok   a result without the expected columns is refused"; fi
if python3 -I - "$CONV" << 'PYTEST'
import sys
src = open(sys.argv[1]).read().replace('if __name__ == "__main__":', "if False:")
m = {}
exec(compile(src, "delta", "exec"), m)
NS, stop, w = 10**9, 100000 * 10**9, m["window_start"]
assert w(stop, None) == stop - 65 * 60 * NS, "first run"
assert w(stop, stop - 3600 * NS) == stop - 65 * 60 * NS, "hourly run"
assert w(stop, stop - 3 * 3600 * NS) == stop - (3 * 3600 + 300) * NS, "two runs missed"
assert w(stop, stop - 90 * 3600 * NS) == stop - 26 * 3600 * NS, "capped at 26 h"
PYTEST
then echo "ok   window: 65 min, back to the last success after a miss, capped at 26 h"; else echo "FAIL window"; fails=1; fi
[ "$fails" = 0 ] && echo "influx-delta-convert-test PASS" || { echo "influx-delta-convert-test FAIL"; exit 1; }
