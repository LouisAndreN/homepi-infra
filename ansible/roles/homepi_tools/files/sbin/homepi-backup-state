#!/usr/bin/env bash
# homepi-backup-state v3: safety net for everything that is not InfluxDB data (age-encrypted).
# Usage: sudo homepi-backup-state AGE_RECIPIENT [AGE_RECIPIENT...]
set -euo pipefail
[ "$EUID" -eq 0 ] || { echo "run as root (sudo)" >&2; exit 1; }
[ $# -ge 1 ] || { echo "usage: $0 AGE_RECIPIENT..." >&2; exit 1; }
RECIPIENTS=()
for r in "$@"; do
  [[ "$r" == age1* ]] || { echo "ERROR: invalid age recipient '$r'" >&2; exit 1; }
  RECIPIENTS+=(-r "$r")
done
for c in age sqlite3 tar; do
  command -v "$c" >/dev/null || { echo "missing command: $c (apt install age sqlite3)" >&2; exit 1; }
done

DEST=/mnt/data/backups/homepi
mountpoint -q /mnt/data/backups || { echo "ERROR: /mnt/data/backups is not mounted" >&2; exit 1; }
STAMP=$(date +%F-%H%M%S)
WORK=$DEST/state-work-$STAMP
install -d -m 0711 "$DEST"
install -d -m 0700 "$WORK"

CA_STOPPED=0
cleanup() {
  if [ "$CA_STOPPED" = 1 ]; then systemctl start step-ca || echo "WARNING: step-ca failed to restart" >&2; fi
  rm -rf "$WORK"
}
trap cleanup EXIT

# 1) SQLite databases: online-consistent copies (WAL-safe)
for db in /var/lib/grafana/grafana.db /var/lib/authelia/db.sqlite3 /var/lib/homepi/devices.db; do
  if [ -f "$db" ]; then
    install -d "$WORK/sqlite$(dirname "$db")"
    # Wait up to 30 s for a writer (Grafana cleans up at night), then retry twice
    for attempt in 1 2 3; do
      sqlite3 -cmd ".timeout 30000" "$db" ".backup '$WORK/sqlite$db'" && break
      [ "$attempt" -lt 3 ] || { echo "ERROR: $db stayed locked after 3 attempts" >&2; exit 1; }
      echo "sqlite locked, retrying in 10 s: $db" >&2
      sleep 10
    done
    echo "sqlite ok: $db"
  else
    echo "skip (missing): $db" >&2
  fi
done

# 2) Configuration and state files. step-ca (BadgerDB) is stopped briefly: unsafe to copy live.
#    tar exit code 1 only means "a file changed while reading": acceptable here.
if systemctl is-active --quiet step-ca; then systemctl stop step-ca; CA_STOPPED=1; fi
# Pinned binaries are reinstalled by Ansible. Terraform keeps its state, not its provider cache or plans.
rc=0
# SQLite state outside /var/lib/homepi, copied consistently (v0.1.87): Authelia (TOTP
# registrations) and Grafana (users and roles; dashboards and data sources come from Terraform).
mkdir -p "$WORK/sqlite-extra"
for db in /var/lib/authelia/db.sqlite3 /var/lib/grafana/grafana.db; do
  sqlite3 "$db" ".backup '$WORK/sqlite-extra/$(basename "$db")'" || { echo "ERROR: sqlite backup of $db failed" >&2; exit 1; }
done
tar -C / -cf "$WORK/etc-and-state.tar" \
  --exclude='etc/homepi-gitops/age.key' --exclude='etc/shadow*' --exclude='etc/gshadow*' \
  --exclude='var/lib/homepi/*.db*' \
  --exclude='usr/local/bin/loki' --exclude='usr/local/bin/node_exporter' --exclude='usr/local/bin/sops' \
  --exclude='var/lib/homepi-terraform/data' --exclude='var/lib/homepi-terraform/review-data' \
  --exclude='var/lib/homepi-terraform/*.plan' --exclude='var/lib/homepi-terraform/*.bin' \
  --exclude='var/lib/homepi-terraform/*.json' \
  etc usr/local/bin usr/local/sbin var/lib/homepi var/lib/secrets var/lib/netbird var/lib/homepi-terraform || rc=$?
[ "$rc" -le 1 ] || { echo "ERROR: tar failed (exit $rc)" >&2; exit 1; }
if [ "$CA_STOPPED" = 1 ]; then systemctl start step-ca; CA_STOPPED=0; fi

# 3) Application code under /opt (no venvs, node_modules, build output or reinstallable binaries)
rc=0
tar -C / -cf "$WORK/opt.tar" \
  --exclude='*/node_modules' --exclude='*/venv' --exclude='*/api-venv' --exclude='*/dist' \
  --exclude='*/__pycache__' --exclude='opt/prometheus' --exclude='opt/alertmanager' --exclude='opt/containerd' \
  --exclude='opt/terraform' --exclude='opt/homepi-gitops' \
  --exclude='opt/aws-signing-helper' --exclude='opt/homepi-aws' \
  opt || rc=$?
[ "$rc" -le 1 ] || { echo "ERROR: tar failed (exit $rc)" >&2; exit 1; }

# 4) Encrypt everything
du -sh "$WORK"/*.tar
OUT=$DEST/homepi-state-$STAMP.tar.age
[ ! -e "$OUT" ] || { echo "ERROR: $OUT already exists, refusing to overwrite it" >&2; exit 1; }
tar -C "$WORK" -cf - . | age "${RECIPIENTS[@]}" > "$OUT"
[ -s "$OUT" ] || { echo "ERROR: empty backup file" >&2; exit 1; }
chmod 0600 "$OUT"
( cd "$DEST" && sha256sum "$(basename "$OUT")" > "$(basename "$OUT").sha256" )
ls -l "$OUT"
echo "DONE"
