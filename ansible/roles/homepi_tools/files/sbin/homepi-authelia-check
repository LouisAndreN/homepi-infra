#!/bin/bash
# homepi-authelia-check: Authelia, the 2FA portal in front of every HomePi web service, is healthy.
# Exit 0 only if the service is active, /api/health answers 200, an anonymous visit through nginx is
# redirected to auth.homepi.internal, and the installed binary accepts the configuration.
set -u
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
CFG=/etc/authelia/configuration.yml
fail=0
ok() { echo "ok   $*"; }
bad() { echo "FAIL $*"; fail=1; }
if systemctl is-active -q authelia; then ok "service active ($(authelia --version 2>/dev/null | awk '{print $3}'))"; else bad "service $(systemctl is-active authelia)"; fi
h=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 http://127.0.0.1:9091/api/health)
if [ "$h" = 200 ]; then ok "/api/health 200"; else bad "/api/health $h"; fi
r=$(curl -sk -o /dev/null -w '%{http_code} %{redirect_url}' --max-time 5 https://homepi.internal/)
case "$r" in
  "302 https://auth.homepi.internal/"*) ok "anonymous visit redirected to the portal" ;;
  *) bad "anonymous visit: $r" ;;
esac
ENVF=$(systemctl show authelia -p EnvironmentFiles --value | awk '{print $1}')
v=$( ( set -a; [ -f "$ENVF" ] && . "$ENVF"; set +a; timeout 60 runuser -u authelia -- authelia validate-config --config "$CFG" 2>&1 ) | tail -1)
case "$v" in
  *"successfully without errors"*) ok "configuration valid" ;;
  *) bad "configuration: $(printf '%s' "$v" | cut -c1-120)" ;;
esac
exit $fail
