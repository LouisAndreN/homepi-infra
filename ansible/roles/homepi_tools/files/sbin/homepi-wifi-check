#!/bin/bash
# homepi-wifi-check: health of the IoT access point, of what the next boot will run, and of apt.
# The access point (wlx0013eff27090) needs the out-of-tree 88x2bu driver, built by DKMS for every
# kernel. On 2026-11-09 the build failed for a new kernel: unattended upgrades stopped on a dpkg
# error, and a reboot would have left the ESP32s without network. Nothing reported it.
# Third-party packages (Authelia, CrowdSec, NetBird, Grafana...) are never installed by unattended
# upgrades: their pending upgrades are tracked here with the time each one was first seen.
# Writes textfile metrics every 15 minutes; the alerts are in boot_chain.yml.
set -u
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
IFACE=wlx0013eff27090
MODULE=88x2bu
OUT=/var/lib/node_exporter/textfile_collector/homepi_wifi.prom
UULOG=/var/log/unattended-upgrades/unattended-upgrades.log
PEND=/var/lib/homepi/apt-pending.tsv
NOW=$(date +%s)

# True when a module built for kernel $1 exists (plain or compressed)
has_module() {
  local f
  f=$(find "/lib/modules/$1" -name "$MODULE.ko*" -type f 2>/dev/null | head -1)
  [ -n "$f" ] && [ "$(modinfo -F vermagic "$f" 2>/dev/null | cut -d' ' -f1)" = "$1" ]
}

next=unknown
for k in /boot/vmlinuz-*; do cmp -s /boot/firmware/vmlinuz "$k" && next=${k#/boot/vmlinuz-}; done
next_ok=0; [ "$next" != unknown ] && has_module "$next" && next_ok=1
installed=0; missing=0
for k in $(dpkg-query -W -f '${Package} ${Status}\n' 'linux-image-[0-9]*' 2>/dev/null | awk '$4 == "installed" { sub("linux-image-", "", $1); print $1 }'); do
  installed=$((installed + 1))
  has_module "$k" || missing=$((missing + 1))
done
loaded=0; awk '{print $1}' /proc/modules | grep -qx "$MODULE" && loaded=1
hostapd=0; systemctl is-active -q hostapd && hostapd=1
stations=$(iw dev "$IFACE" station dump 2>/dev/null | grep -c '^Station')
audit=$(dpkg --audit 2>/dev/null | grep -cE '^ [a-z]')
# The last unattended-upgrades run fails if any of its lines is an ERROR (its final line may still
# read "No packages found" after a dpkg failure, as on 2026-11-10)
uu_ok=$(awk '/Starting unattended upgrades script/ { seen = 1; err = 0 } / ERROR / { err = 1 } END { print (seen && err) ? 0 : 1 }' "$UULOG" 2>/dev/null || echo 1)
uu_start=$(grep -h 'Starting unattended upgrades script' "$UULOG" 2>/dev/null | tail -1 | cut -c1-19)
uu_ts=0; [ -n "$uu_start" ] && uu_ts=$(date -d "$uu_start" +%s 2>/dev/null || echo 0)
# APT writes update-success-stamp only when every source was refreshed
succ=$(stat -c %Y /var/lib/apt/periodic/update-success-stamp 2>/dev/null || echo 0)

# Pending upgrades from a simulation (no lock, no cache write), each with the time first seen
SIM=$(apt-get -s -o Debug::NoLocking=1 -o Dir::Cache::pkgcache= -o Dir::Cache::srcpkgcache= dist-upgrade 2>/dev/null | awk '/^Inst / {
  cand = ($3 ~ /^\[/) ? $4 : $3; sub(/^\(/, "", cand)
  cls = ($0 ~ /Ubuntu:/) ? (($0 ~ /-security/) ? "ubuntu-security" : "ubuntu") : "third-party"
  print $2, cand, cls }')
touch "$PEND"
printf '%s\n' "$SIM" | awk -v now="$NOW" 'FILENAME == ARGV[1] { if (NF == 4) first[$1 " " $2] = $4; next }
  NF == 3 { k = $1 " " $2; print $1, $2, $3, ((k in first) ? first[k] : now) }' "$PEND" /dev/stdin > "$PEND.tmp" && mv "$PEND.tmp" "$PEND"

TMP=$(mktemp "$OUT.XXXXXX")
{
cat << PROM
# HELP homepi_wifi_driver_next_boot_ok 1 if the kernel of the next boot has the $MODULE module.
# TYPE homepi_wifi_driver_next_boot_ok gauge
homepi_wifi_driver_next_boot_ok{kernel="$next"} $next_ok
# HELP homepi_wifi_driver_kernels_installed Installed kernel images.
# TYPE homepi_wifi_driver_kernels_installed gauge
homepi_wifi_driver_kernels_installed $installed
# HELP homepi_wifi_driver_kernels_missing Installed kernel images without the $MODULE module.
# TYPE homepi_wifi_driver_kernels_missing gauge
homepi_wifi_driver_kernels_missing $missing
# HELP homepi_wifi_driver_loaded 1 if the $MODULE module is loaded.
# TYPE homepi_wifi_driver_loaded gauge
homepi_wifi_driver_loaded $loaded
# HELP homepi_wifi_hostapd_active 1 if hostapd is active.
# TYPE homepi_wifi_hostapd_active gauge
homepi_wifi_hostapd_active $hostapd
# HELP homepi_wifi_ap_stations Stations associated with the IoT access point.
# TYPE homepi_wifi_ap_stations gauge
homepi_wifi_ap_stations $stations
# HELP homepi_apt_dpkg_audit_packages Packages that dpkg --audit reports as broken or half-configured.
# TYPE homepi_apt_dpkg_audit_packages gauge
homepi_apt_dpkg_audit_packages $audit
# HELP homepi_apt_unattended_last_run_ok 1 if the last unattended-upgrades run had no ERROR line.
# TYPE homepi_apt_unattended_last_run_ok gauge
homepi_apt_unattended_last_run_ok $uu_ok
# HELP homepi_apt_unattended_last_run_timestamp_seconds Start of the last unattended-upgrades run.
# TYPE homepi_apt_unattended_last_run_timestamp_seconds gauge
homepi_apt_unattended_last_run_timestamp_seconds $uu_ts
# HELP homepi_apt_update_success_timestamp_seconds Last apt list refresh in which every source succeeded.
# TYPE homepi_apt_update_success_timestamp_seconds gauge
homepi_apt_update_success_timestamp_seconds $succ
# HELP homepi_apt_upgradable_packages Pending upgrades by class (ubuntu-security, ubuntu, third-party).
# TYPE homepi_apt_upgradable_packages gauge
# HELP homepi_apt_upgrade_pending_oldest_seconds Age of the oldest pending upgrade of the class, since first seen.
# TYPE homepi_apt_upgrade_pending_oldest_seconds gauge
PROM
for c in ubuntu-security ubuntu third-party; do
  echo "homepi_apt_upgradable_packages{class=\"$c\"} $(awk -v c="$c" '$3 == c' "$PEND" | wc -l)"
  echo "homepi_apt_upgrade_pending_oldest_seconds{class=\"$c\"} $(awk -v c="$c" -v now="$NOW" '$3 == c { a = now - $4; if (a > m) m = a } END { print m + 0 }' "$PEND")"
done
cat << PROM
# HELP homepi_wifi_check_last_run_timestamp_seconds Last run of homepi-wifi-check.
# TYPE homepi_wifi_check_last_run_timestamp_seconds gauge
homepi_wifi_check_last_run_timestamp_seconds $NOW
PROM
} > "$TMP"
chmod 0644 "$TMP"
mv "$TMP" "$OUT"
