[Unit]
Description=Hourly delta of the sensor buckets (RPO 1 h; the nightly native backup holds the rest)

[Timer]
# :07, clear of the native backup (03:50) and of the weekly export that stops InfluxDB (Sun 04:18)
OnCalendar=*-*-* *:07
Persistent=true
Unit=homepi-backup@influx-delta.service

[Install]
WantedBy=timers.target
