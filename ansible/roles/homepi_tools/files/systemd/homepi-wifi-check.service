[Unit]
Description=HomePi IoT access point, next-boot Wi-Fi driver and apt health (textfile metrics)

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/homepi-wifi-check
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/node_exporter/textfile_collector
