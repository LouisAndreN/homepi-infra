#!/bin/bash
# homepi-gitops-sync: reconcile this host from the newest signed release tag.
#
#   homepi-gitops-sync apply   deploy the newest signed tag (never an older one)
#   homepi-gitops-sync check   dry run of the deployed tag, to detect drift
#   homepi-gitops-sync reconcile  apply the deployed tag again, its signature verified again, to
#                                 undo a drift (a package upgrade resetting permissions, for example)
#
# The trust anchor is /etc/homepi-gitops/allowed_signers: created by hand and
# deliberately outside the repository that this script deploys.
set -euo pipefail
umask 077
export HOME=/root PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

REMOTE="${HOMEPI_GITOPS_REMOTE:-/var/lib/homepi-gitops/origin.git}"
STATE_DIR=/var/lib/homepi-gitops
WORK="$STATE_DIR/work"
DEPLOYED="$STATE_DIR/deployed"
SIGNERS=/etc/homepi-gitops/allowed_signers
GITHUB_URL="${HOMEPI_GITOPS_GITHUB:-git@github.com:LouisAndreN/homepi-infra.git}"
DEPLOY_KEY=/etc/homepi-gitops/github_deploy_key
GITHUB_KNOWN_HOSTS=/etc/homepi-gitops/github_known_hosts
AGE_KEY=/etc/homepi-gitops/age.key
RUNTIME=/opt/homepi-gitops
METRICS_DIR=/var/lib/node_exporter/textfile_collector
TF_STATE_DIR=/var/lib/homepi-terraform

log() { echo "homepi-gitops: $*"; }

# Write a Prometheus textfile atomically: write a hidden temp file, then rename it
write_metrics() {
  local file="$1" tmp
  shift
  tmp=$(mktemp "$METRICS_DIR/.tmp.XXXXXX")
  printf '%s\n' "$@" > "$tmp"
  chmod 0644 "$tmp"
  mv "$tmp" "$METRICS_DIR/$file"
}

# Record a failure for the given mode, then stop
fail() {
  # A failed reconcile is reported as a failed apply, so that GitopsApplyFailing covers it
  [ "$1" = reconcile ] && set -- apply "$2"
  log "FAILED: $2"
  write_metrics "homepi_gitops_$1.prom" \
    "homepi_gitops_${1}_success 0" \
    "homepi_gitops_${1}_timestamp_seconds $(date +%s)"
  exit 1
}

verify_tag() {
  git -C "$WORK" -c gpg.format=ssh -c gpg.ssh.allowedSignersFile="$SIGNERS" tag -v "$1"
}

# Run the playbook locally; print its output and keep the number of changed tasks
run_playbook() {
  local out rc=0 check=()
  [ "$1" = check ] && check=(--check)
  out=$(mktemp)
  cd "$WORK/ansible"
  ANSIBLE_COLLECTIONS_PATH="$RUNTIME/collections" SOPS_AGE_KEY_FILE="$AGE_KEY" ANSIBLE_NOCOLOR=1 \
    "$RUNTIME/venv/bin/ansible-playbook" -i inventory/pi-local.yml site.yml "${check[@]}" > "$out" 2>&1 || rc=$?
    # Keep the full playbook output (root only, 30 newest): a failed task is diagnosable afterwards
    install -d -m 0700 /var/log/homepi-gitops 2> /dev/null || true
    cp "$out" "/var/log/homepi-gitops/$(date +%F-%H%M%S)-${1:-run}.log" 2> /dev/null && chmod 0600 /var/log/homepi-gitops/*.log 2> /dev/null || true
    ls -1t /var/log/homepi-gitops/*.log 2> /dev/null | tail -n +31 | xargs -r rm -f || true
  cat "$out"
  CHANGED=$(sed -nE 's/^homepi +: .*changed=([0-9]+).*/\1/p' "$out")
  rm -f "$out"
  return "$rc"
}

# Pick the tag to work on. To check: the deployed tag. To apply: the newest tag with a
# trusted signature. Tags without one are skipped, logged and counted, so a rogue tag
# can neither be deployed nor block a legitimate release.
select_tag() {
  local candidate
  UNTRUSTED=0
  if [ "$1" = check ] || [ "$1" = reconcile ]; then
    [ -n "$CUR_TAG" ] || { log "nothing deployed yet, nothing to $1"; exit 0; }
    TAG="$CUR_TAG"
    verify_tag "$TAG" || fail "$1" "REFUSED: the deployed tag $TAG is no longer trusted"
    return 0
  fi
  TAG=""
  while read -r candidate; do
    if verify_tag "$candidate"; then
      TAG="$candidate"
      break
    fi
    log "REFUSED: tag $candidate is not signed by a key listed in $SIGNERS"
    UNTRUSTED=$((UNTRUSTED + 1))
  done < <(git -C "$WORK" tag --list 'v[0-9]*' --sort=-version:refname | sed -n '1,20p')
  [ -n "$TAG" ] || fail "$1" "no tag with a trusted signature"
}

# Refuse a moved tag and any tag older than the one already deployed
guard_downgrade() {
  local newest
  [ -n "$CUR_TAG" ] || return 0
  if [ "$TAG" = "$CUR_TAG" ]; then
    [ "$COMMIT" = "$CUR_COMMIT" ] || fail "$1" "REFUSED: tag $TAG moved from $CUR_COMMIT to $COMMIT"
    return 0
  fi
  newest=$(printf '%s\n%s\n' "$CUR_TAG" "$TAG" | sort -V | sed -n '$p')
  [ "$newest" = "$TAG" ] || fail "$1" "REFUSED: $TAG is older than the deployed $CUR_TAG"
}

record_apply() {
  write_metrics homepi_gitops_apply.prom \
    "homepi_gitops_apply_success 1" \
    "homepi_gitops_apply_timestamp_seconds $(date +%s)" \
    "homepi_gitops_untrusted_tags ${UNTRUSTED:-0}" \
    "homepi_gitops_deployed_info{tag=\"$TAG\",commit=\"${COMMIT:0:12}\"} 1"
}

tag_allows_destroy() {
  git -C "$WORK" tag -l --format='%(contents)' "$TAG" | grep -qF '[allow-destroy]'
}

# Textfile metrics of the Terraform step: success flag, planned changes and planned destroys
tf_metrics() {
  write_metrics homepi_gitops_terraform.prom \
    "homepi_gitops_terraform_success $1" \
    "homepi_gitops_terraform_timestamp_seconds $(date +%s)" \
    "homepi_gitops_terraform_planned_changes ${PLANNED:-0}" \
    "homepi_gitops_terraform_planned_destroys ${DESTROYS:-0}"
}

# Plan the Grafana root. In apply mode, refuse a plan that destroys anything unless the signed
# tag message contains [allow-destroy], then apply the very plan that was checked.
run_terraform() {
  local mode="$1" root="$WORK/terraform/grafana" secrets="$WORK/ansible/secrets/grafana.sops.yaml"
  local plan="$TF_STATE_DIR/plan.bin"
  PLANNED=0 DESTROYS=0 TF_REASON=""
  [ -d "$root" ] || { log "no Terraform root in $TAG, skipping"; return 0; }

  export CHECKPOINT_DISABLE=1 TF_IN_AUTOMATION=1 TF_DATA_DIR="$TF_STATE_DIR/data"
  TF_VAR_grafana_token=$(SOPS_AGE_KEY_FILE="$AGE_KEY" sops decrypt --extract '["grafana_terraform_token"]' "$secrets") \
    || { TF_REASON="cannot decrypt the Grafana token"; tf_metrics 0; return 1; }
  export TF_VAR_grafana_token

  cd "$root"
  terraform init -input=false -no-color -lockfile=readonly \
    -backend-config="path=$TF_STATE_DIR/grafana.tfstate" > /dev/null \
    || { TF_REASON="terraform init failed"; tf_metrics 0; return 1; }
  terraform plan -input=false -no-color -lock-timeout=60s -out="$plan" > /dev/null \
    || { TF_REASON="terraform plan failed"; tf_metrics 0; return 1; }

  PLANNED=$(terraform show -json "$plan" | jq '[.resource_changes[]? | select((.change.actions != ["no-op"] and .change.actions != ["read"]) or (.change.importing != null))] | length') \
    || { TF_REASON="cannot read the plan"; rm -f "$plan"; tf_metrics 0; return 1; }
  DESTROYS=$(terraform show -json "$plan" | jq '[.resource_changes[]? | select(.change.actions | index("delete"))] | length') \
    || { TF_REASON="cannot read the plan"; rm -f "$plan"; tf_metrics 0; return 1; }
  log "terraform: $PLANNED change(s) planned, $DESTROYS destroy(s)"

  if [ "$mode" = apply ]; then
    if [ "$DESTROYS" -gt 0 ] && ! tag_allows_destroy; then
      terraform show -json "$plan" | jq -r '.resource_changes[] | select(.change.actions | index("delete")) | "  would destroy: " + .address'
      TF_REASON="REFUSED: the plan destroys $DESTROYS resource(s) and the signed tag message has no [allow-destroy]"
      rm -f "$plan"; tf_metrics 0; return 1
    fi
    terraform apply -input=false -no-color -lock-timeout=60s "$plan" > /dev/null \
      || { TF_REASON="terraform apply failed"; rm -f "$plan"; tf_metrics 0; return 1; }
    log "terraform: applied $PLANNED change(s)"
    PLANNED=0 DESTROYS=0
  fi
  rm -f "$plan"
  tf_metrics 1
}

# GitHub is the main source; the local bare repository (pushed from the laptop) is the fallback.
# Tags are pruned only against GitHub, and only when GitHub answered: pruning against the local
# repository too would delete a tag published on GitHub only. Every tag is still verified against
# allowed_signers: GitHub is a source, not a trust anchor.
fetch_sources() {
  local gh_ok=0 last
  git -C "$WORK" remote get-url github > /dev/null 2>&1 || git -C "$WORK" remote add github "$GITHUB_URL"
  git -C "$WORK" remote set-url github "$GITHUB_URL"
  if [ -r "$DEPLOY_KEY" ] && GIT_SSH_COMMAND="ssh -i $DEPLOY_KEY -o IdentitiesOnly=yes -o UserKnownHostsFile=$GITHUB_KNOWN_HOSTS -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=15" \
       git -C "$WORK" fetch --quiet --force --prune --prune-tags github; then
    gh_ok=1
  else
    log "WARNING: cannot fetch from GitHub ($GITHUB_URL), using the local push repository only"
  fi
  last=$(sed -n 's/^homepi_gitops_github_last_success_timestamp_seconds //p' "$METRICS_DIR/homepi_gitops_github.prom" 2>/dev/null || true)
  [ "$gh_ok" = 1 ] && last=$(date +%s)
  write_metrics homepi_gitops_github.prom \
    "homepi_gitops_github_fetch_success $gh_ok" \
    "homepi_gitops_github_last_success_timestamp_seconds ${last:-0}"
  if ! git -C "$WORK" fetch --quiet --force --tags origin; then
    [ "$gh_ok" = 1 ] || fail "$1" "cannot fetch from GitHub nor from $REMOTE"
    log "WARNING: cannot fetch from $REMOTE, using GitHub only"
  fi
}

main() {
  local mode="${1:-}"
  case "$mode" in apply | check | reconcile) ;; *) echo "usage: $0 apply|check|reconcile" >&2; exit 2 ;; esac
  exec 9> /run/homepi-gitops.lock
  flock -n 9 || { log "another run is in progress"; exit 0; }

  [ -d "$WORK/.git" ] || git clone --quiet "$REMOTE" "$WORK" || fail "$mode" "cannot clone $REMOTE"
  fetch_sources "$mode"

  CUR_TAG="" CUR_COMMIT=""
  [ ! -f "$DEPLOYED" ] || read -r CUR_TAG CUR_COMMIT < "$DEPLOYED"

  select_tag "$mode"
  # Deploy the commit the verified tag points to, not the tag name
  COMMIT=$(git -C "$WORK" rev-list -n 1 "$TAG")
  guard_downgrade "$mode"

  if [ "$mode" = apply ] && [ "$TAG" = "$CUR_TAG" ]; then
    log "tag $TAG is already deployed"
    record_apply
    exit 0
  fi

  git -C "$WORK" checkout --quiet --force --detach "$COMMIT"
  log "$mode: $TAG ($COMMIT)"
  run_playbook "$mode" || fail "$mode" "ansible-playbook failed"
  run_terraform "$mode" || fail "$mode" "$TF_REASON"

  if [ "$mode" = apply ]; then
    printf '%s %s\n' "$TAG" "$COMMIT" > "$DEPLOYED"
    record_apply
  elif [ "$mode" = reconcile ]; then
    # Same tag and commit: nothing new is deployed, the apply metrics cover the run
    record_apply
  else
    write_metrics homepi_gitops_check.prom \
      "homepi_gitops_check_success 1" \
      "homepi_gitops_check_timestamp_seconds $(date +%s)" \
      "homepi_gitops_drift_changed_tasks ${CHANGED:-0}"
  fi
  log "$mode finished: $TAG, changed tasks: ${CHANGED:-0}"
}

main "$@"
