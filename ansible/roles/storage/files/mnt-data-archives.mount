[Unit]
Description=BTRFS IoT Archives Subvolume
After=mnt-data.mount
Requires=mnt-data.mount

[Mount]
What=/dev/vg-main/lv-data
Where=/mnt/data/archives
Type=btrfs
# Btrfs applies compress per filesystem: the first mount (@iot-hot, zstd:3) sets it for every subvolume
Options=defaults,noatime,compress=zstd:3,space_cache=v2,subvol=@iot-archives

[Install]
WantedBy=multi-user.target
