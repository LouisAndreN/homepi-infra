# HomePi MQTT ACL — use_identity_as_username = true
# %u = CN du LDevID = device_id

# ── Devices IoT (ESP32) ──────────────────────────────────────
pattern write iot/%u/sensors
pattern write iot/%u/nilm
pattern write iot/%u/status
pattern read  iot/%u/commands

# ── Telegraf bridge (port 1883 loopback) ─────────────────────
user telegraf-bridge
topic read iot/#

# --- homepi-api (FastAPI) ---------------
# Publie les commandes OTA/Wifi/renew vers les devices
user homepi-api
topic write iot/#
topic write homepi/#
topic read  iot/+/sensors
