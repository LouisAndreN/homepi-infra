# HomePi MQTT ACL for the loopback listener 1883 (service accounts, password file).
# Device certificates use listener 8883 and the generated devices.acl, never this file.
user telegraf-bridge
topic read iot/#

user homepi-api
# Commands to devices and the operator alert topic only (v0.1.112): with write iot/# the API
# account could publish telemetry in the name of any sensor.
topic write iot/+/commands
topic write homepi/admin/alerts
topic read  iot/+/sensors
