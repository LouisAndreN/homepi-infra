# Managed by Ansible (service_ordering).
# The mTLS listener binds {{ service_ordering_iot_address }}, which exists only once hostapd and networkd have
# configured the access point (measured 2026-11-07: mosquitto failed at 18.3 s, the address appeared at 20.2 s).
[Unit]
After=hostapd.service systemd-networkd.service
Wants=hostapd.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
ExecStartPre=/usr/bin/timeout {{ service_ordering_wait_seconds }} /bin/sh -c "until ip -4 -o addr show dev {{ service_ordering_iot_interface }} | grep -q ' inet {{ service_ordering_iot_address }}/'; do sleep 1; done"
Restart=on-failure
RestartSec=5s
