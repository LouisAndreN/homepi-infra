#!/bin/bash
# Check the Pi's DNS: split horizon per Unbound view, the IoT path through dnsmasq, and DNSSEC
# validation (positive and negative). External probes are skipped, not failed, when the root
# servers are unreachable. Usage: homepi-dns-check LAN_IP NETBIRD_IP IOT_GATEWAY_IP
set -u
LAN=$1; NB=$2; IOT=$3; fail=0
ok()  { echo "ok   $1"; }
bad() { echo "FAIL $1"; fail=1; }
a=$(dig @127.0.0.1 homepi.internal +short +time=2 +tries=1)
[ "$a" = "$LAN" ] && ok "view lan: homepi.internal -> $a" || bad "view lan: homepi.internal -> '$a', expected $LAN"
a=$(dig @"$LAN" -b "$NB" homepi.internal +short +time=2 +tries=1)
[ "$a" = "$NB" ] && ok "view netbird: homepi.internal -> $a" || bad "view netbird: homepi.internal -> '$a', expected $NB"
a=$(dig @"$IOT" homepi.internal +short +time=2 +tries=1)
[ -n "$a" ] && ok "IoT path (dnsmasq -> Unbound): homepi.internal -> $a" || bad "IoT path: no answer from $IOT"
if dig @127.0.0.1 . NS +time=3 +tries=1 | grep -q 'status: NOERROR'; then
  # C5 and C7 (2026-11-24): two to three minutes after a boot, with an empty cache, the first answers
  # came back without the ad flag, and a few seconds later they were validated. An empty cache is not
  # a fault: retry for up to 90 s; an Unbound that still does not validate after that is one.
  v=0
  for _ in $(seq 1 18); do
    r=$(dig @127.0.0.1 isc.org SOA +dnssec +time=3 +tries=1)
    if printf '%s\n' "$r" | grep -q 'status: NOERROR' && printf '%s\n' "$r" | grep -qE 'flags:[a-z ]* ad'; then v=1; break; fi
    sleep 5
  done
  [ "$v" = 1 ] && ok "DNSSEC positive: isc.org validated (ad)" || bad "DNSSEC positive: isc.org not validated after 90 s"
  st=""
  for _ in 1 2 3; do
    # 10 s per try: the broken zone's servers are slow to give up on; an empty answer is handled below
    st=$(dig @127.0.0.1 dnssec-failed.org A +time=10 +tries=1 | grep -oE 'status: [A-Z]+' | cut -d' ' -f2)
    [ -n "$st" ] && break
  done
  case "$st" in
    SERVFAIL) ok "DNSSEC negative: dnssec-failed.org rejected (SERVFAIL)" ;;
    # No answer proves nothing either way: the zone's own servers did not answer (an external test
    # domain, flaky on the rebuilt Pi during C3, 2026-11-21). Only an answer other than SERVFAIL proves
    # that validation is not enforced, and that still fails.
    "") echo "warn DNSSEC negative: no answer after 3 tries (inconclusive, not counted)" ;;
    *) bad "DNSSEC negative: dnssec-failed.org answered $st: validation not enforced" ;;
  esac
else
  echo "skip DNSSEC probes: root servers unreachable"
fi
exit $fail
