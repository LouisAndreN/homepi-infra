[Unit]
Description=HomePi Admin API (admin surface, unix socket, nginx only)
After=homepi-api.service homepi-api-admin.socket
Requires=homepi-api.service homepi-api-admin.socket

[Service]
Type=simple
User=homepi-api
Group=homepi-api
WorkingDirectory=/opt/homepi/api
EnvironmentFile=-/etc/homepi/api.env
Environment=HOMEPI_API_SURFACE=admin
ExecStart=/opt/homepi/api-venv/bin/uvicorn provisioning_api:app --fd 3 --workers 1 --log-level info
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
