[Unit]
Description=HomePi Admin API (loopback)
After=homepi-api.service
Requires=homepi-api.service

[Service]
Type=simple
User=homepi-api
Group=homepi-api
WorkingDirectory=/opt/homepi/api
EnvironmentFile=-/etc/homepi/api.env
ExecStart=/opt/homepi/api-venv/bin/uvicorn provisioning_api:app --host 127.0.0.1 --port 8091 --workers 1 --log-level info
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
