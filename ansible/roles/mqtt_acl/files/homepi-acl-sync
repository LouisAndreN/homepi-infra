#!/usr/bin/env python3
"""Render the MQTT device ACL (listener 8883) from the HomePi device registry.

Allow-list: only devices whose registry status allows MQTT get their topics.
Any other client certificate (unknown CN, suspended device, non-device name)
gets no rule and is denied by mosquitto. The file is written atomically and
mosquitto is reloaded (SIGHUP) only when the content changes. Results go to
the node_exporter textfile collector.

Usage: homepi-acl-sync           render, write if changed, reload mosquitto
       homepi-acl-sync --print   render to stdout, change nothing
"""
import grp
import json
import os
import pwd
import re
import subprocess
import sys
import tempfile
import time

DB = "/var/lib/homepi/devices.db"
DB_USER = "homepi-api"  # WAL database: read as its owner, so no root-owned -wal/-shm files appear
ACL = "/etc/mosquitto/acl/devices.acl"
ACL_OWNER = ("mosquitto", "mosquitto")
PROM = "/var/lib/node_exporter/textfile_collector/homepi_mqtt_acl.prom"
ALLOWED = ("active", "approved", "pre_announced")
DEVICE_ID = re.compile(r"esp32-[0-9a-f]{8}")  # also blocks ACL injection through a crafted device_id
# event (v1.3.0): start/end of platform events (Teensy update through the NILM bridge, later OTA and
# appliance runs) for the dashboard timeline; stored in homepi_events.
TOPICS = (("write", "sensors"), ("write", "nilm"), ("write", "status"), ("write", "event"), ("read", "commands"))
HEADER = "# Generated by homepi-acl-sync from the device registry. Do not edit."


def read_registry():
    r = subprocess.run(
        ["runuser", "-u", DB_USER, "--", "sqlite3", "-readonly", "-json", DB,
         "SELECT device_id, status FROM devices ORDER BY device_id;"],
        capture_output=True, text=True, timeout=30, cwd="/")
    if r.returncode != 0:
        raise RuntimeError("registry read failed: " + r.stderr.strip()[:200])
    return json.loads(r.stdout) if r.stdout.strip() else []


def render(rows):
    allowed, invalid = set(), 0
    for row in rows:
        dev, status = str(row.get("device_id") or ""), str(row.get("status") or "")
        if not DEVICE_ID.fullmatch(dev):
            invalid += 1
        elif status in ALLOWED:
            allowed.add(dev)
    lines = [HEADER,
             "# Allowed statuses: " + ", ".join(ALLOWED) + ".",
             "# Any other certificate has no rule here and is denied by mosquitto."]
    for dev in sorted(allowed):
        lines += ["", "user " + dev] + [f"topic {acc} iot/{dev}/{t}" for acc, t in TOPICS]
    return "\n".join(lines) + "\n", len(allowed), invalid


def atomic_write(path, text, uid, gid, mode):
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix="." + os.path.basename(path) + ".")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.chown(tmp, uid, gid)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def write_metrics(success, allowed=None, invalid=None):
    old = {}
    try:
        with open(PROM) as f:
            for line in f:
                parts = line.split()
                if len(parts) == 2 and not line.startswith("#"):
                    old[parts[0]] = parts[1]
    except OSError:
        pass
    now = int(time.time())
    m = {
        "homepi_mqtt_acl_sync_success": int(success),
        "homepi_mqtt_acl_last_run_timestamp_seconds": now,
        "homepi_mqtt_acl_last_success_timestamp_seconds":
            now if success else old.get("homepi_mqtt_acl_last_success_timestamp_seconds", 0),
        "homepi_mqtt_acl_allowed_devices":
            allowed if allowed is not None else old.get("homepi_mqtt_acl_allowed_devices", 0),
        "homepi_mqtt_acl_invalid_device_ids":
            invalid if invalid is not None else old.get("homepi_mqtt_acl_invalid_device_ids", 0),
    }
    atomic_write(PROM, "".join(f"{k} {v}\n" for k, v in m.items()), 0, 0, 0o644)


def fail(msg):
    print("homepi-acl-sync: FAILED: " + msg, file=sys.stderr)
    write_metrics(False)
    return 1


def main():
    args = sys.argv[1:]
    if args not in ([], ["--print"]):
        print(__doc__, file=sys.stderr)
        return 2
    try:
        text, n, invalid = render(read_registry())
    except Exception as e:  # noqa: BLE001 - any failure keeps the current ACL
        if args:
            print("homepi-acl-sync: FAILED: " + str(e), file=sys.stderr)
            return 1
        return fail(str(e))
    if args:
        sys.stdout.write(text)
        print(f"# {n} device(s) allowed, {invalid} invalid id(s) skipped", file=sys.stderr)
        return 0
    try:
        with open(ACL) as f:
            current = f.read()
    except FileNotFoundError:
        current = ""
    had_rules = any(l.startswith(("user ", "pattern ")) for l in current.splitlines())
    if n == 0 and had_rules:
        return fail("the registry returned no allowed device; refusing to remove every device")
    changed = text != current
    if changed:
        try:
            atomic_write(ACL, text, pwd.getpwnam(ACL_OWNER[0]).pw_uid, grp.getgrnam(ACL_OWNER[1]).gr_gid, 0o640)
        except Exception as e:  # noqa: BLE001
            return fail("cannot write " + ACL + ": " + str(e))
        r = subprocess.run(["systemctl", "reload", "mosquitto"], capture_output=True, text=True, timeout=30)
        if r.returncode != 0:
            return fail("mosquitto reload failed: " + r.stderr.strip()[:200])
    write_metrics(True, n, invalid)
    print(f"homepi-acl-sync: {n} device(s) allowed, {invalid} invalid id(s) skipped, "
          + ("ACL updated, mosquitto reloaded" if changed else "unchanged"))
    return 0


if __name__ == "__main__":
    sys.exit(main())
