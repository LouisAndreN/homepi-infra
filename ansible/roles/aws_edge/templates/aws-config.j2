# Managed by Ansible (aws_edge role). Temporary credentials from IAM Roles Anywhere; no AWS key is stored.
# Both profiles present the same certificate; each role grants one permission only.
[profile edge-writer]
region = {{ aws_edge_region }}
credential_process = /usr/local/bin/aws_signing_helper credential-process --certificate {{ aws_edge_dir }}/edge.crt --private-key {{ aws_edge_dir }}/edge.key --trust-anchor-arn {{ aws_edge_secrets.aws_edge_trust_anchor_arn }} --profile-arn {{ aws_edge_secrets.aws_edge_profile_arn }} --role-arn {{ aws_edge_secrets.aws_edge_role_arn }}

[profile edge-heartbeat]
region = {{ aws_edge_region }}
credential_process = /usr/local/bin/aws_signing_helper credential-process --certificate {{ aws_edge_dir }}/edge.crt --private-key {{ aws_edge_dir }}/edge.key --trust-anchor-arn {{ aws_edge_secrets.aws_edge_trust_anchor_arn }} --profile-arn {{ aws_edge_secrets.aws_edge_profile_arn }} --role-arn {{ aws_edge_secrets.aws_edge_role_arn | regex_replace(':role/.*$', ':role/homepi-edge-heartbeat') }}

[profile edge-logs]
region = {{ aws_edge_region }}
credential_process = /usr/local/bin/aws_signing_helper credential-process --certificate {{ aws_edge_dir }}/edge.crt --private-key {{ aws_edge_dir }}/edge.key --trust-anchor-arn {{ aws_edge_secrets.aws_edge_trust_anchor_arn }} --profile-arn {{ aws_edge_secrets.aws_edge_profile_arn }} --role-arn {{ aws_edge_secrets.aws_edge_role_arn | regex_replace(':role/.*$', ':role/homepi-edge-logs') }}
