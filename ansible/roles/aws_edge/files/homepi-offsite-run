#!/bin/bash
# Managed by Ansible (role aws_edge).
# Uploads the newest verified archive of each backup kind off-site, once. Runs hourly, decoupled
# from the backups: a failed upload (network, DNS, credentials) never fails the local backup and is
# retried at the next run. Failures are reported by the homepi_offsite_* metrics of
# homepi-offsite-upload and their alerts, not by this unit's exit code.
# A marker <archive>.offsite records a successful upload; homepi-backup-run prunes it with the archive.
set -euo pipefail
umask 077
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

DEST=/mnt/data/backups/homepi
declare -A PREFIX=([state]=homepi-state [influx-lp]=influx-lp [influx-native]=influx-native [influx-delta]=influx-delta)

archives() {  # oldest first
  find "$DEST" -maxdepth 1 -regextype posix-extended \
    -regex ".*/${PREFIX[$1]}-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{4}([0-9]{2})?\.tar\.age" \
    -printf '%T@ %p\n' | sort -n | cut -d' ' -f2-
}

upload() {  # 0 uploaded or already there, 1 not ready, 2 failed
  local kind=$1 archive=$2 name out
  name=$(basename "$archive")
  [ -e "$archive.offsite" ] && return 0
  # Not ready while the backup is still being written and verified
  if [ ! -s "$archive.sha256" ] || [ -n "$(find "$archive.sha256" -mmin -2)" ]; then
    echo "homepi-offsite: $kind: $name not ready yet, next run"
    return 1
  fi
  if out=$(homepi-offsite-upload "$archive" "$kind" 2>&1); then
    echo "$out"
    printf '%s %s\n' "$(date -Is)" "$out" > "$archive.offsite"
    return 0
  fi
  echo "$out" >&2
  return 2
}

for kind in state influx-lp influx-native influx-delta; do
  mapfile -t list < <(archives "$kind")
  if [ "${#list[@]}" = 0 ]; then
    echo "homepi-offsite: $kind: no archive yet"
    continue
  fi
  if [ "$kind" = influx-delta ]; then
    # Every delta matters (each one covers its own hours): upload all that are missing, oldest first,
    # and stop at the first failure so the order is kept and the next run retries from there
    for a in "${list[@]}"; do upload "$kind" "$a" || break; done
  else
    # One archive is a full copy: only the newest needs to be off-site
    newest=${list[-1]}
    if [ -e "$newest.offsite" ]; then echo "homepi-offsite: $kind: $(basename "$newest") already uploaded"; continue; fi
    upload "$kind" "$newest" || true
  fi
done
