server {
    listen 80;
    server_name auth.homepi.internal;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name auth.homepi.internal;

    include snippets/ssl-homepi.conf;

    # Override X-Frame-Options - Authelia requires DENY
    add_header X-Frame-Options "DENY" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Deactivate HSTS of snippet for auth (managed separately)
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:;" always;

    location / {
        proxy_pass http://127.0.0.1:9091/;
	proxy_set_header Host $host;
	proxy_set_header X-Real-IP $remote_addr;
	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_set_header X-Forwarded-Host $host;

	# Mask Authelia headers - Nginx manage its owns
	proxy_hide_header X-Frame-Options;
	proxy_hide_header X-Content-Type-Options;
	proxy_hide_header Strict-Transport-Security;
	proxy_hide_header Referrer-Policy;
	proxy_hide_header Content-Security-Policy;
	proxy_hide_header Permissions-Policy;
	proxy_hide_header X-Dns-prefetch-Control;

    }
}
