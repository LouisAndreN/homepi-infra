server {
    listen 80;
    listen [::]:80 default_server;
    server_name homepi homepi.internal _;
    #add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    return 301 https://homepi.internal$request_uri;
}

server {
    listen 443 ssl http2;
    server_name homepi homepi.internal;
    
    ssl_certificate     /etc/nginx/ssl/wildcard.homepi.fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/wildcard.homepi.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    #ssl_session_cache   shared:SSL:10m;

    ssl_client_certificate /etc/nginx/ssl/client-ca-chain.pem;
    ssl_verify_client      optional;
    ssl_verify_depth       2;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options    "nosniff" always;
    #add_header Referrer-Policy           "strict-origin-when-cross-origin" always;

    # --- Authelia verify ----------------
    location = /authelia/api/verify {
        internal;
        proxy_pass              http://127.0.0.1:9091/api/verify;
        proxy_pass_request_body off;
        proxy_set_header        Content-Length     "";
        proxy_set_header        X-Original-URL     $scheme://$host$request_uri;
        proxy_set_header        X-Real-IP          $remote_addr;
        proxy_set_header        X-Forwarded-For    $proxy_add_x_forwarded_for;
        proxy_set_header        X-Forwarded-Proto  $scheme;
        proxy_set_header        X-Forwarded-Uri    $request_uri;
        proxy_set_header        X-Forwarded-Method $request_method;
        proxy_set_header        X-Forwarded-Host   $host;
        proxy_connect_timeout   5s;
        proxy_read_timeout      10s;
    }

    # ---------- Download Root CA Certificate ------
    location = /root-ca.crt {
        root /var/www/homepi-dashboard;
        add_header Content-Type "application/x-x509-ca-cert";
        add_header Content-Disposition "attachment; filename=root-ca.crt";
    }

    location = /site.webmanifest {
        root /var/www/homepi-dashboard;
        add_header Cache-Control "no-cache";
    }

    location = /sw.js {
        root /var/www/homepi-dashboard;
        add_header Cache-Control "no-cache, no store, must-revalidate";
        add_header Service-Worker-Allowed "/";
    }

    location /icons/ {
        root /var/www/homepi-dashboard;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # --- Firmware binaires (OTA) -------------
    location /fw/ {
        allow 192.168.200.0/24;
        allow 127.0.0.1;
        deny all;

        alias /opt/homepi/firmware/;
        autoindex off;
        add_header Content-Disposition attachment;
    }

    # --- React App - Vite static file ----------------
    location / {
	auth_request     /authelia/api/verify;
        auth_request_set $authelia_user $upstream_http_remote_user;
        auth_request_set $authelia_name $upstream_http_remote_name;
        auth_request_set $authelia_groups $upstream_http_remote_groups;
        auth_request_set $authelia_redirect $upstream_http_location;
        #auth_request_set $target_url    $scheme://$host$request_uri;
        error_page 401   =302 https://auth.homepi.internal/?rd=$scheme://$host$request_uri;

        #add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options    "nosniff" always;
        add_header X-Frame-Options           "SAMEORIGIN" always;
	add_header X-XSS-Protection "1; mode=block" always;

	add_header Cache-Control "no-store, no-cache, must-revalidate" always;
	add_header Pragma "no-cache" always;

        root  /var/www/homepi-dashboard;
        index index.html;
        try_files $uri $uri/ /index.html;

	if ($arg_rd) {
            rewrite ^(.*)$ $1? permanent;
        }

        # Long cache for Vite assets (hash in name)
        location ~* ^/static/ {
            expires    1y;
            add_header Cache-Control "public, immutable";
            try_files $uri =404;
        }

    }

    # --- InfluxDB API -- React -> InfluxDB direct ---------------
    # InfluxDB: query only (v0.1.61). nginx replaces any Authorization header with a
    # read-only token on iot-hot (snippet rendered from SOPS, 0600 root). The browser
    # holds no token. Every other InfluxDB route is refused before Authelia.
    location = /influx/api/v2/query {
        allow 192.168.0.0/24;
        allow 100.64.0.0/10;
        allow 127.0.0.1;
        deny  all;

        auth_request     /authelia/api/verify;
        error_page 401   =302 https://auth.homepi.internal/?rd=$scheme://$host$request_uri;

        include            /etc/nginx/snippets/homepi-influx-auth.conf;
        proxy_pass         http://127.0.0.1:8086/api/v2/query;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_buffering    off;
        proxy_read_timeout 30s;
    }

    location /influx/ {
        return 403;
    }

    # --- Prometheus API -- React -> Prometheus direct -----
    location /prom-api/ {
	allow 192.168.0.0/24;
	allow 100.64.0.0/10;
	allow 127.0.0.1;
	deny  all;

	auth_request      /authelia/api/verify;
	error_page 401    =302 https://auth.homepi.internal/?rd=$target_url;

	proxy_pass         http://127.0.0.1:9090/api/v1/;
	proxy_set_header   Host              $host;
	proxy_set_header   X-Real-IP         $remote_addr;
	proxy_read_timeout 30s;
    }

    # --- Loki API -- React -> Loki direct -------------
    location /loki-api/ {
	allow 192.168.0.0/24;
	allow 100.64.0.0/10;
	allow 127.0.0.1;
	deny  all;

	auth_request     /authelia/api/verify;
	error_page 401   =302 https://auth.homepi.internal/?rd=$scheme://$host$request_uri;

	proxy_pass         http://127.0.0.1:3100/loki/api/v1/;
	proxy_set_header   Host              $host;
	proxy_set_header   X-Real-IP         $remote_addr;
	proxy_read_timeout 30s;
    }

    # --- API admin IoT (fleet + pairing SSE) ------------
    location /api/admin/ {
	allow 192.168.0.0/24;
	allow 100.64.0.0/10;
	allow 127.0.0.1;
	deny  all;

	auth_request     /authelia/api/verify;
	error_page 401   =302 https://auth.homepi.internal/?rd=$scheme://$host$request_uri;

	proxy_pass                 http://unix:/run/homepi-api/admin.sock:/api/admin/;

	proxy_set_header           X-SSL-Verify    "";   # device identity headers never reach admin

	proxy_set_header           X-SSL-Client-DN "";
	proxy_set_header           Host      $host;
	proxy_set_header           X-Real-IP $remote_addr;
	proxy_buffering            off;
	proxy_cache                off;
	proxy_read_timeout         120s;
	proxy_set_header           Connection '';
	chunked_transfer_encoding  on;
    }

    # --- API devices (IoT subnet). Registration needs the LDevID as client certificate (v0.1.114) ---
    location /api/devices/ {
	allow 192.168.200.0/24;
	allow 127.0.0.1;
	deny  all;

        # Passer le CN du client cert au backend (pour /api/devices/{id}/renew)
        proxy_set_header X-SSL-Client-DN $ssl_client_s_dn;
        proxy_set_header X-SSL-Verify    $ssl_client_verify;
        # The verified certificate itself: the API reads fingerprint and expiry from it, not from the body
        proxy_set_header X-SSL-Client-Cert $ssl_client_escaped_cert;

	proxy_pass         http://unix:/run/homepi-api/device.sock:/api/devices/;
	proxy_set_header   Host      $host;
	proxy_set_header   X-Real-IP $remote_addr;
	proxy_read_timeout 30s;
    }

    # ---Grafana -- ops tool (no landing page) ------------
    location /grafana/ {
	allow 192.168.0.0/24;
	allow 100.64.0.0/10;
	allow 127.0.0.1;
	deny  all;

	auth_request      /authelia/api/verify;
	auth_request_set  $authelia_user $upstream_http_remote_user;
	error_page 401    =302 https://auth.homepi.internal/?rd=$scheme://$host$request_uri;

	proxy_set_header  X-WEBAUTH-USER    $authelia_user;
	proxy_set_header  Remote-Role       "";   # a client-supplied role is never forwarded
	proxy_pass        http://unix:/run/grafana/grafana.sock:/grafana/;
	proxy_set_header  Host              $host;
	proxy_set_header  X-Real-IP         $remote_addr;
	proxy_set_header  X-Forwarded-For   $proxy_add_x_forwarded_for;
	proxy_set_header  X-Forwarded-Proto $scheme;
	proxy_http_version 1.1;
	proxy_set_header   Upgrade    $http_upgrade;
	proxy_set_header   Connection "upgrade";
	proxy_buffering    off;
	proxy_read_timeout 120s;
    }

    # Prometheus
    location /prometheus/ {
	allow 192.168.0.0/24;
	allow 100.64.0.0/10;
	allow 127.0.0.1;
	deny  all;

	auth_request     /authelia/api/verify;
	error_page 401   =302 https://auth.homepi.internal/?rd=scheme://$host$request_uri;

	proxy_pass http://127.0.0.1:9090/;
	proxy_set_header Host $host;
    }

    # Alertmanager
    location /alertmanager/ {
	allow 192.168.0.0/24;
	allow 100.64.0.0/10;
	allow 127.0.0.1;
	deny  all;

	auth_request     /authelia/api/verify;
	auth_request_set $target_url $scheme://$host$request_uri;
	error_page 401   =302 https://auth.homepi.internal/?rd=$target_url;

	proxy_pass http://127.0.0.1:9093/;
	proxy_set_header Host $host;
    }

    # --- Authelia portal ----------------
    location /authelia/ {
	proxy_pass       http://127.0.0.1:9091/;
	proxy_set_header Host              $host;
	proxy_set_header X-Real-IP         $remote_addr;
	proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
	proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Frowarded-Host  $host;
    }

    # -- step-ca : retrieve Root CA certificate (bootstrap) ----
    # The ESP32 can call this endpoint without a client certificate to verify the CA.
    # In practice : The certificate is pre-flashed in NVS; this endpoint serves as a verification fallback.
    location = /step/roots {
	allow 192.168.200.0/24;
	allow 127.0.0.1;
	deny  all;

	proxy_pass         https://127.0.0.1:8443/roots;
	proxy_ssl_verify   on;
	proxy_ssl_verify_depth 2;
	proxy_ssl_trusted_certificate /etc/step-ca/certs/root_ca.crt;
	proxy_ssl_name     homepi.internal;
	proxy_set_header   Host $host;
	proxy_set_header   X-Real-IP $remote_addr;
	proxy_read_timeout 15s;
    }

    # Intermediate CA (public). Firmware v2.4.0 renews with a token whose x5cInsecure header carries
    # the LDevID chain; step-ca verifies it against its roots, so the intermediate is needed. An LDevID
    # stored by v2.3.x holds the leaf only and fetches the intermediate here once.
    location = /step/intermediates.pem {
        allow 192.168.200.0/24;
        allow 127.0.0.1;
        deny  all;

        proxy_pass              https://127.0.0.1:8443/intermediates.pem;
        proxy_ssl_verify        on;
        proxy_ssl_verify_depth  2;
        proxy_ssl_trusted_certificate /etc/step-ca/certs/root_ca.crt;
        proxy_ssl_name          homepi.internal;
        proxy_set_header        Host $host;
        proxy_read_timeout      15s;
    }

    # --- step-ca : X5C enrollment (zero-touch IDevID -> LDevID) --
    # The ESP32 sends a JWT signed with its IDevID + CSR.
    # step-ca verifies the IDevID against the Manufacturer CA (X5C provisioner)
    # Returns the LDevID certificate.
    location = /step/sign {
        allow 192.168.200.0/24;
	allow 127.0.0.1;
	deny  all;

	proxy_pass              https://127.0.0.1:8443/1.0/sign;
	proxy_ssl_verify   on;
	proxy_ssl_verify_depth 2;
	proxy_ssl_trusted_certificate /etc/step-ca/certs/root_ca.crt;
	proxy_ssl_name     homepi.internal;
	proxy_set_header        Host $host;
	proxy_set_header        X-Real-IP $remote_addr;
	proxy_set_header        Content-Type "application/json";
        proxy_set_header        Content-Length $content_length;
        proxy_pass_request_body on;
	proxy_read_timeout      30s;
    }

    # Device certificate renewal (B3.3): the device signs a token with the key
    # of its current certificate (x5c header). No provisioner password is used;
    # step-ca refuses revoked certificates (passive revocation).
    location = /step/renew {
        allow 192.168.200.0/24;
        allow 127.0.0.1;
        deny  all;

        proxy_pass              https://127.0.0.1:8443/1.0/renew;
        proxy_ssl_verify        on;
        proxy_ssl_verify_depth  2;
        proxy_ssl_trusted_certificate /etc/step-ca/certs/root_ca.crt;
        proxy_ssl_name          homepi.internal;
        proxy_set_header        Host $host;
        proxy_set_header        X-Real-IP $remote_addr;
        proxy_read_timeout      30s;
    }
}

# Machine clients of Grafana (Prometheus, Terraform): loopback only, no Authelia.
# Identity headers are stripped, so Grafana requires its own credentials (basic auth or a token).
server {
    listen 127.0.0.1:3001;
    server_name _;

    location /grafana/ {
        proxy_set_header  X-WEBAUTH-USER "";
        proxy_set_header  Remote-Role    "";
        proxy_set_header  Host           $host;
        proxy_pass        http://unix:/run/grafana/grafana.sock:/grafana/;
    }

    location = /metrics/homepi {
        allow 127.0.0.1;
        deny  all;
        proxy_set_header  X-SSL-Verify    "";
        proxy_set_header  X-SSL-Client-DN "";
        proxy_pass        http://unix:/run/homepi-api/device.sock:/metrics/homepi;
    }

    location / {
        return 404;
    }
}
