# Secrets and key material (never commit)
.env
.env.*
!.env.example
*.key
*.pem
# The OTA public key is public: the Pi verifies uploads with it (v0.1.120)
!ansible/roles/ota_rollout/files/ota_signing_pub.pem
*.age
age.key
keys.txt
secrets/
batch_*.json
# Terraform local state and variables
terraform.tfstate*
.terraform/
*.tfvars
# Build output and caches
node_modules/
dist/
__pycache__/
*.pyc
# Editor backups and leftovers
*.save
*.bak
*.bak-*
*.swp
.lgd-*
.DS_Store
# Firmware binaries: build artifacts, publish as release assets instead
*.bin

# SOPS-encrypted files are meant to be committed
!ansible/secrets/

# Terraform state never goes into git
*.tfstate*
.terraform/
# B11: local Ansible runtime, rebuilt from ansible/requirements.*
/.venv/
/ansible/collections/
